var int lastSdV = 0
var int prevSdV = 0
var int prev2SdV = 0
var bool earlyV = false

// ============================================================================ helpers
dateOf(int t) =>
    year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)

f2(int x) =>
    (x < 10 ? "0" : "") + str.tostring(x)

fHM(int mm) =>
    int m0 = mm < 0 ? mm + 1440 : mm
    f2(math.floor(m0 / 60)) + ":" + f2(m0 % 60)

fP(float p) =>
    str.tostring(p, "#,##0.00")

fPts(float x) =>
    str.tostring(x, "0.0")

fR(float r) =>
    (r >= 0 ? "+" : "−") + str.tostring(math.abs(r), "0.00") + "R"

fUsd(float x) =>
    (x >= 0 ? "+$" : "−$") + str.tostring(math.abs(x), "#,##0")

fDate(int d) =>
    str.tostring(d % 100) + " " + MON.get(math.floor(d / 100) % 100 - 1)

prevTradeDay(int sd) =>
    int t0 = timestamp(TZ, math.floor(sd / 10000), math.floor(sd / 100) % 100, sd % 100, 12, 0, 0)
    int out = 0
    for i = 1 to 10
        int t2 = t0 - i * 86400000
        int w = dayofweek(t2, TZ)
        int d2 = dateOf(t2)
        if out == 0 and w >= dayofweek.monday and w <= dayofweek.friday and not HOL.includes(d2)
            out := d2
    out

// the days drawn: today (before 02:00 also the session that just finished), or two days, or every loaded day
inWindow(int sd) =>
    histIn == H2 or sd == lastSdV or ((histIn == H1 or earlyV) and sd == prevSdV) or (histIn == H1 and earlyV and sd == prev2SdV)

riskUsd(int code) =>
    LDN.get(code) ? rLD : rNY

// the side's view: a short is a long on mirrored prices (price -> -price), so every rule exists once
vH(Day d, int s, int k) =>
    s > 0 ? d.h.get(k) : -d.l.get(k)

vL(Day d, int s, int k) =>
    s > 0 ? d.l.get(k) : -d.h.get(k)

vO(Day d, int s, int k) =>
    s * d.o.get(k)

vC(Day d, int s, int k) =>
    s * d.c.get(k)

zv(Day d, int s, int i) =>
    s > 0 ? d.z.get(i) : -d.z.get(ZMIR.get(i))

zName(int s, int i) =>
    s > 0 ? ZN.get(i) : ZN.get(ZMIR.get(i))

lowView(Day d, int s, int a, int b) =>
    float lo = vL(d, s, a)
    if b > a
        for q = a + 1 to b
            lo := math.min(lo, vL(d, s, q))
    lo

// the zones known at a minute (a candle's start), merged within 2 points (the first name of the course's order wins), in
// the side's view; London: only the zones of L2
zonesAt(Day d, int s, int minute, bool lon) =>
    array<int> ids = array.new<int>()
    array<float> ps = array.new<float>()
    for i = 0 to 13
        float p = zv(d, s, i)
        if not na(p) and minute >= ZKNOWN.get(i) and (not lon or ZLON.get(i))
            bool dup = false
            for q in ps
                if math.abs(p - q) <= MERGE
                    dup := true
            if not dup
                ids.push(i)
                ps.push(p)
    [ids, ps]

// the candles of the signals (long view): hammer, engulfing, strong
hammer(Day d, int s, int j) =>
    float o = vO(d, s, j)
    float h = vH(d, s, j)
    float l = vL(d, s, j)
    float c = vC(d, s, j)
    float rng = h - l
    float body = math.abs(c - o)
    float wick = math.min(o, c) - l
    rng > 0 and wick >= 2 * body and wick >= 0.5 * rng

engulf(Day d, int s, int j) =>
    bool res = false
    if j >= 1
        float o0 = vO(d, s, j - 1)
        float c0 = vC(d, s, j - 1)
        float rb = o0 - c0
        float rr = vH(d, s, j - 1) - vL(d, s, j - 1)
        float o1 = vO(d, s, j)
        float c1 = vC(d, s, j)
        res := c1 > o1 and rb > 0 and o1 <= c0 and c1 >= o0 and (c1 - o1) >= 1.5 * rb and rr > 0 and rb > 0.1 * rr
    res

strong(Day d, int s, int j) =>
    bool res = false
    if j >= 1
        float o = vO(d, s, j)
        float h = vH(d, s, j)
        float l = vL(d, s, j)
        float c = vC(d, s, j)
        float rng = h - l
        res := rng > 0 and c > o and (c - o) >= 0.5 * rng and (h - c) <= 0.3 * rng and rng >= 0.8 * d.a.get(j - 1)
    res

kindOf(Day d, int s, int j) =>
    hammer(d, s, j) ? "hammer" : engulf(d, s, j) ? "engulfing" : strong(d, s, j) ? "strong candle" : ""

// the trend check: swing structure of the last 36 candles + the last 6 closes vs the POC + the bodies of the last 12;
// each part is +1 (for the side), -1 (against it) or 0
scoreParts(Day d, int s, int i) =>
    float hLast = na
    float hPrev = na
    float lLast = na
    float lPrev = na
    int nh = 0
    int nl = 0
    int j0 = math.max(2, i - 36)
    int j1 = i - 2
    if j1 >= j0
        for j = j0 to j1
            float hj = vH(d, s, j)
            float lj = vL(d, s, j)
            float mx = hj
            float mn = lj
            for q = j - 2 to j + 2
                mx := math.max(mx, vH(d, s, q))
                mn := math.min(mn, vL(d, s, q))
            if hj == mx
                hPrev := hLast
                hLast := hj
                nh += 1
            if lj == mn
                lPrev := lLast
                lLast := lj
                nl += 1
    int s1 = 0
    if nh >= 2 and nl >= 2
        if hLast > hPrev and lLast > lPrev
            s1 := 1
        else if hLast < hPrev and lLast < lPrev
            s1 := -1
    float poc = zv(d, s, 11)
    bool allUp = true
    bool allDn = true
    for q = math.max(0, i - 5) to i
        float cq = vC(d, s, q)
        if not (cq > poc)
            allUp := false
        if not (cq < poc)
            allDn := false
    int s2 = allUp ? 1 : allDn ? -1 : 0
    float gsum = 0.0
    float rsum = 0.0
    for q = math.max(0, i - 11) to i
        float b = vC(d, s, q) - vO(d, s, q)
        if b > 0
            gsum += b
        else if b < 0
            rsum -= b
    int s3 = (gsum > 1.5 * rsum and gsum > 0) ? 1 : (rsum > 1.5 * gsum and rsum > 0) ? -1 : 0
    [s1, s2, s3]

score(Day d, int s, int i) =>
    [p1, p2, p3] = scoreParts(d, s, i)
    p1 + p2 + p3

newSig(St g, Day d, int code, int s, int k, int mk, float entry, float stop) =>
    g.nextId += 1
    Trade.new(id = g.nextId, code = code, side = s, date = d.date, j = k, ct = mk + 5, sigBar = bar_index, entry = entry, stop = stop, risk = entry - stop, vr = d.vr.get(k), bxs = array.new<box>(), lns = array.new<line>(), lbs = array.new<label>())

// ============================================================================ texts
head(Trade x) =>
    LET.get(x.code) + " " + (x.side > 0 ? "LONG" : "SHORT") + " · " + SNAME.get(x.code)

say(St g, bool on, string txt) =>
    if on
        g.msg.push(txt)
    true

howText(string how) =>
    switch how
        "target" => "target"
        "stop" => "stop"
        "be" => "stop at the entry"
        "trail" => "trailing stop"
        "time" => "time limit"
        "t1" => "first target (1 contract)"
        => how

reasonText(string why) =>
    switch why
        "pause" => "pause after a loss"
        "taken" => "already taken today"
        "size" => "the stop is too wide for the amount"
        "seats" => "both seats in use"
        "side" => "a trade in the other direction is open"
        => why

endText(Trade x) =>
    x.code == 6 ? "out at 08:00" : x.code == 7 ? "out at " + fHM(x.endM) + " at the latest" : x.code == 2 ? "out at 15:55 at the latest" : "out at " + fHM(x.endM) + " at the latest"

planText(Trade x) =>
    int s = x.side
    string dn = s > 0 ? "under" : "over"
    string out = ""
    if x.code == 0
        out := "target " + fP(s * x.t2p) + " (2.5R) for the whole trade"
    else if x.code == 1 and x.split
        string zt = x.tgtName + " " + fP(s * x.t1p) + " (" + str.tostring(x.tgtR, "0.00") + "R)"
        out := x.m > 1 ? "half at " + zt + ", then the stop to the entry and the rest trails 1 pt " + dn + " the last 3 candles" : "1 contract: all at " + zt
    else if x.code == 1
        out := "no zone 1.5R away: from +1R " + fP(s * x.trailFrom) + " the whole trade trails 1 pt " + dn + " the last 3 candles"
    else if x.code == 2
        out := "stop to the entry at +1.5R " + fP(s * x.beAt) + " · target " + fP(s * x.t2p) + " (4R) for the whole trade"
    else if x.code == 3 or x.code == 5
        string f = x.code == 3 ? " (0.75R)" : " (0.5R)"
        out := x.m > 1 ? "half at " + fP(s * x.t1p) + f + ", then the stop to the entry and the rest trails 1 pt " + dn + " each candle" : "1 contract: all at " + fP(s * x.t1p) + f
    else
        out := x.m > 1 ? "half at " + fP(s * x.t1p) + " (1R), then the stop to the entry · the rest at " + fP(s * x.t2p) + " (3R)" : "1 contract: all at " + fP(s * x.t1p) + " (1R)"
    out + " · " + endText(x)

// why the signal came: the zone, the candle, the volume and the trend check
whyText(Trade t) =>
    int s = t.side
    string vrx = "volume " + str.tostring(t.vr, "0.00") + "x"
    string out = ""
    if t.code == 0
        out := "9 o'clock gap " + fP(math.min(s * t.gBot, s * t.gTop)) + " – " + fP(math.max(s * t.gBot, s * t.gTop)) + " · inverse FVG " + fP(math.min(s * t.fBot, s * t.fTop)) + " – " + fP(math.max(s * t.fBot, s * t.fTop))
    else if t.code == 1
        out := zName(s, t.zi) + " " + fP(s * t.zp) + " broken with " + vrx + " and held on the retest · trend " + str.tostring(t.sc)
    else if t.code == 2 or t.code == 6
        out := zName(s, t.zi) + " " + fP(s * t.zp) + ": the first close outside the range · " + vrx + " · trend " + str.tostring(t.sc)
    else if t.code == 4
        out := t.kind + " after a stretch far from VWAP · " + vrx
    else if t.code == 5
        out := zName(s, t.zi) + " " + fP(s * t.zp) + ": price ran through it and closed back · trend " + str.tostring(t.sc)
    else
        out := zName(s, t.zi) + " " + fP(s * t.zp) + " held · " + t.kind + " · " + vrx + (t.code == 7 ? " · trend " + str.tostring(t.sc) : "")
    out

// the trade's card, shown when you hover over any of its marks: the result first, then the entry, the stop, the exit and why
tipText(Trade t) =>
    int s = t.side
    string nm = LET.get(t.code) + " " + (s > 0 ? "LONG" : "SHORT") + " · " + SNAME.get(t.code)
    string tx = ""
    if t.skipped
        tx := nm + "\nNOT TAKEN: " + t.note + "\nSignal candle " + fHM(t.ct - 5) + " (closed " + fHM(t.ct) + ") · " + (t.code == 0 ? "limit " : "entry would be ") + fP(s * t.entry) + " · stop " + fP(s * t.stop) + " (" + fPts(t.risk) + " pts)\nWhy: " + whyText(t)
    else if t.tin < 0
        tx := nm + "\nLimit order " + fP(s * t.entry) + " · stop " + fP(s * t.stop) + " (" + fPts(t.risk) + " pts) · target " + fP(s * (t.entry + 2.5 * t.risk)) + " (2.5R)\nWaits until " + fHM(t.ct + WAITM) + "; cancelled if price first reaches " + fP(s * (t.entry + t.risk)) + " (1R)" + (t.note != "" ? "\n" + t.note : "")
    else
        bool fin = not t.isOpen and t.texit >= 0
        string res = not fin ? "OPEN" : t.r > 0.05 ? "WON " + fUsd(t.pnl) + " · " + fR(t.r) : t.r < -0.05 ? "LOST " + fUsd(t.pnl) + " · " + fR(t.r) : "EVEN " + fUsd(t.pnl) + " · " + fR(t.r)
        tx := nm + "\n" + res
        tx += "\nEntry " + fHM(t.tin) + " at " + fP(s * t.entry) + (t.code == 0 ? " (limit order)" : "") + " · " + str.tostring(t.m) + " " + CNAME
        tx += "\nStop " + fP(s * t.stop) + " · " + fPts(t.risk) + " pts · risk $" + str.tostring(t.m * PV * t.risk, "#,##0")
        if t.split and t.armed and t.m > 1
            tx += "\nFirst target " + fHM(t.tFirst) + " at " + fP(s * t.t1p) + ": " + str.tostring(math.ceil(t.m / 2)) + " " + CNAME + " closed"
        if fin
            tx += "\nExit " + fHM(t.texit) + " at " + fP(t.exitPx) + " · " + howText(t.how) + " · after $" + str.tostring(FEE * t.m, "#,##0") + " commission"
        tx += "\nPlan: " + planText(t)
        tx += "\nWhy: " + whyText(t) + " · signal candle " + fHM(t.ct - 5)
    tx

// ============================================================================ trades: the exits, the seats, the pause
dropOpen(Day d, Trade t) =>
    int ix = -1
    int n = d.opened.size()
    if n > 0
        for i = 0 to n - 1
            if d.opened.get(i).id == t.id
                ix := i
    if ix >= 0
        d.opened.remove(ix)
    true

// the result: half of the contracts (rounded up) at the first target, the rest at the end; 1 contract: all at the first
// target. Dollars after the commission; R = dollars / (contracts x stop x point value)
settle(St g, Day d, Trade t, float leg0, float leg1, int tFirst, int texit, string how, float px) =>
    int m = t.m
    float pts = m * leg1 * t.risk
    int tx = texit
    string hw = how
    if t.split and t.armed and m > 1
        int m1 = math.ceil(m / 2)
        pts := (m1 * leg0 + (m - m1) * leg1) * t.risk
    else if t.split and t.armed
        pts := m * leg0 * t.risk
        hw := "t1"
        tx := tFirst
    t.pnl := PV * pts - FEE * m
    t.r := t.pnl / (PV * m * t.risk)
    t.texit := tx
    t.how := hw
    t.leg0 := leg0
    t.tFirst := tFirst
    t.isOpen := false
    t.exitBar := bar_index
    t.exitPx := px
    dropOpen(d, t)
    if t.r < -0.05
        d.losses += 1
        d.busy := math.max(d.busy, tx + pauseMin)
    g.cN += 1
    g.cW += t.r > 0.05 ? 1 : 0
    g.cUsd += t.pnl
    if g.cFirst == 0
        g.cFirst := t.date
    say(g, alClose, (t.r > 0.05 ? "✅ WON " : t.r < -0.05 ? "❌ LOST " : "➖ EVEN ") + fUsd(t.pnl) + " · " + head(t) + " · closed: " + howText(hw) + " " + fP(px) + " · " + fR(t.r) + " · " + fUsd(t.pnl) + " · " + fHM(tx) + " NY")
    true

openTrade(Day d, Trade x, int t, int m) =>
    x.tin := t
    x.m := m
    x.isOpen := true
    x.pending := false
    x.st := x.stop
    float e = x.entry
    float risk = x.risk
    int c = x.code
    x.endM := c == 2 ? FLAT : c == 6 ? LONEND : c == 7 ? math.min(t + HOLDM, LONEND) : math.min(t + HOLDM, FLAT)
    if c == 0
        x.t2p := e + 2.5 * risk
    else if c == 1
        // B: half at the first zone 1.5R or more away (known when the retest closed); no zone: the whole trade trails from +1R
        x.trailN := 3
        [zid, zps] = zonesAt(d, x.side, x.ct, false)
        float tp = na
        int ti = -1
        int nz = zid.size()
        if nz > 0
            for qi = 0 to nz - 1
                float p = zps.get(qi)
                if p >= e + 1.5 * risk and (na(tp) or p < tp)
                    tp := p
                    ti := zid.get(qi)
        if na(tp)
            x.trailFrom := e + risk
        else
            x.t1p := tp
            x.split := true
            x.tgtName := zName(x.side, ti)
            x.tgtR := (tp - e) / risk
    else if c == 2
        x.beAt := e + 1.5 * risk
        x.t2p := e + 4.0 * risk
    else if c == 3
        x.t1p := e + 0.75 * risk
        x.split := true
        x.trailN := 1
    else if c == 5
        x.t1p := e + 0.5 * risk
        x.split := true
        x.trailN := 1
    else
        x.t1p := e + risk
        x.t2p := e + 3.0 * risk
        x.split := true
    d.trades.push(x)
    d.opened.push(x)
    true

// a signal at minute t (a close, or the fill minute of A's limit order) meets the day's rules; "" = taken
event(St g, Day d, Trade x, int t) =>
    string why = ""
    if t < d.busy
        why := "pause"
    else if (x.code == 0 and d.usedA) or (x.code == 2 and d.usedC) or (x.code == 6 and d.usedL1)
        why := "taken"
    else
        string key = str.tostring(x.ct) + "/" + str.tostring(x.side) + "/" + str.tostring(x.code)
        if d.seen.includes(key)
            why := "taken"
        else if d.opened.size() >= SEATS
            why := "seats"
        else
            for c in d.opened
                if c.side != x.side
                    why := "side"
            if why == ""
                int m = math.min(MAXM, math.floor(riskUsd(x.code) / (PV * x.risk)))
                if m < 1
                    why := "size"
                else
                    d.seen.push(key)
                    if x.code == 0
                        d.usedA := true
                    if x.code == 2
                        d.usedC := true
                    if x.code == 6
                        d.usedL1 := true
                    openTrade(d, x, t, m)
    why

// one minute of an open trade (side view): the stop, the first target (half; the stop to the entry), C's +1.5R (the stop
// to the entry), the target, B's +1R (the trailing starts), the trailing stop when a 5-minute candle finishes (it counts
// from the next minute), the time limit (out at that minute's close)
manageMin(St g, Day d, Trade t, int mm, float h, float l, float c, int mk, float curL, float curH) =>
    int s = t.side
    float hv = s > 0 ? h : -l
    float lv = s > 0 ? l : -h
    float cv = s * c
    float e = t.entry
    float risk = t.risk
    bool closed = false
    if lv <= t.st
        float px = t.st - SLIP
        float rs = (px - e) / risk
        string how = ""
        if t.armed or t.trailing
            how := math.abs(t.st - e) < 1e-9 ? "be" : t.st > e ? "trail" : "stop"
            if t.trailing and not t.armed and t.st <= t.stop + 1e-9
                how := "stop"
        else
            how := t.st <= t.stop + 1e-9 ? "stop" : math.abs(t.st - e) < 1e-9 ? "be" : "trail"
        settle(g, d, t, t.armed and t.split ? t.leg0 : rs, rs, t.armed and t.split ? t.tFirst : mm, mm, how, s * px)
        closed := true
    if not closed and not na(t.t1p) and not t.armed and hv >= t.t1p + THR
        t.armed := true
        t.leg0 := (t.t1p - e) / risk
        t.tFirst := mm
        t.st := math.max(t.st, e)
        if t.m == 1
            settle(g, d, t, t.leg0, t.leg0, mm, mm, "t1", s * t.t1p)
            closed := true
        else
            say(g, alStep, "💰 FIRST TARGET · " + head(t) + " · first target " + fP(s * t.t1p) + " reached: close " + str.tostring(math.ceil(t.m / 2)) + " " + CNAME + ", move the stop on the rest to the entry " + fP(s * e) + " · " + fHM(mm) + " NY")
    if not closed and not na(t.beAt) and not t.armed and hv >= t.beAt + THR
        t.armed := true
        t.tFirst := mm
        t.st := math.max(t.st, e)
        say(g, alStep, "🛡 STOP TO ENTRY · " + head(t) + " · +1.5R " + fP(s * t.beAt) + " reached: move the stop to the entry " + fP(s * e) + " · " + fHM(mm) + " NY")
    if not closed and not na(t.t2p) and hv >= t.t2p + THR
        float rt = (t.t2p - e) / risk
        settle(g, d, t, t.armed and t.split ? t.leg0 : rt, rt, t.armed and t.split ? t.tFirst : mm, mm, "target", s * t.t2p)
        closed := true
    if not closed and not na(t.trailFrom) and not t.trailing and hv >= t.trailFrom + THR
        t.trailing := true
        say(g, alStep, "📈 TRAILING STARTS · " + head(t) + " · +1R " + fP(s * t.trailFrom) + " reached: the stop now trails 1 pt " + (s > 0 ? "under" : "over") + " the last 3 candles · " + fHM(mm) + " NY")
    if not closed and t.trailN > 0 and (t.armed or t.trailing) and (mm + 1) % 5 == 0 and mk == mm - 4
        float lo = s > 0 ? curL : -curH
        int k = d.m.size()
        if t.trailN > 1
            for q = 1 to t.trailN - 1
                if k - q >= 0
                    lo := math.min(lo, vL(d, s, k - q))
        float nt = lo - 1.0
        if nt > t.st + 1e-9
            t.st := nt
            say(g, alTrail, "↕ TRAILING STOP · " + head(t) + " · trailing stop → " + fP(s * nt) + " · " + fHM(mm + 1) + " NY")
    if not closed and mm >= t.endM
        float rx = (cv - e) / risk
        settle(g, d, t, t.armed and t.split ? t.leg0 : rx, rx, t.armed and t.split ? t.tFirst : mm, t.endM, "time", s * cv)
    true

// A's limit order ends: cancelled (1R first), or its 30 minutes are over; a later turn may place a new order from then
endOrder(St g, Day d, Trade p, int tFree, string note, string msg) =>
    Scan sc = p.side > 0 ? d.scL : d.scS
    sc.aFree := tFree
    d.pend := na
    p.pending := false
    p.note := note
    p.exitBar := bar_index
    say(g, alSig, "A ORDER ENDED · " + head(p) + " · " + msg)
    true

// the 1-minute candles of a 5-minute candle: A's waiting limit order first, then every open trade
processMinutes(St g, Day d, array<int> ta, array<float> ha, array<float> la, array<float> ca, int mk, float curL, float curH) =>
    int n = ta.size()
    if n > 0
        for q = 0 to n - 1
            int tq = ta.get(q)
            int mod = hour(tq, TZ) * 60 + minute(tq, TZ)
            int mm = mod < 1080 ? mod : mod - 1440
            float h = ha.get(q)
            float l = la.get(q)
            float c = ca.get(q)
            if not na(d.pend)
                Trade p = d.pend
                int s = p.side
                if mm >= p.ct + WAITM
                    endOrder(g, d, p, p.ct + WAITM, "not filled in 30 minutes", "limit order not filled in 30 minutes: cancel it · " + fHM(p.ct + WAITM) + " NY")
                else
                    float lv = s > 0 ? l : -h
                    float hv = s > 0 ? h : -l
                    if lv <= p.entry - THR
                        d.pend := na
                        Scan sc = s > 0 ? d.scL : d.scS
                        sc.nine := 2
                        p.inBar := bar_index
                        string why = event(g, d, p, mm)
                        if why == ""
                            d.shown.push(p)
                            d.last := p
                            g.flash := bar_index
                            say(g, alSig, "🔔 A FILLED · " + head(p) + " · filled at " + fP(s * p.entry) + " · stop " + fP(s * p.stop) + " · " + planText(p) + " · " + str.tostring(p.m) + " " + CNAME + " · " + fHM(mm) + " NY")
                        else
                            p.pending := false
                            p.skipped := true
                            p.note := reasonText(why)
                            p.exitBar := bar_index
                            d.last := p
                            say(g, alSkip, "⚪ NOT TAKEN · " + head(p) + " · price reached the limit " + fP(s * p.entry) + ", but the plan skips it (" + reasonText(why) + ") · " + fHM(mm) + " NY")
                    else if hv >= p.entry + p.risk
                        endOrder(g, d, p, mm + 1, "cancelled: 1R reached first", "limit order cancelled: price reached " + fP(s * (p.entry + p.risk)) + " (1R) first · " + fHM(mm) + " NY")
            if d.opened.size() > 0
                array<Trade> cur = d.opened.copy()
                for t in cur
                    if t.isOpen
                        manageMin(g, d, t, mm, h, l, c, mk, curL, curH)
            d.lastM1 := mm
            d.lastC1 := c
    true

// ============================================================================ the eight setups, both sides, at every close
// A · Nine O'Clock Turn: the 9 o'clock candle's 15-minute gap; from 10:00 price fakes into it and turns: a limit order at
// the fake move's last 5-minute gap (the inverse FVG). Not filled: a later turn through a new inverse FVG, by 13:00, may
// place a new order
scanA(St g, Day d, Scan sc, int s, int k, int mk, array<Trade> out) =>
    if sc.nine != 2 and mk >= 600
        if sc.nine == 0
            bool okAll = true
            for q = 0 to 18
                int mm = q < 18 ? 510 + 5 * q : 600
                if not d.idx.contains(mm)
                    okAll := false
            if not okAll
                sc.nine := 2
            else
                int i540 = d.idx.get(540)
                int i595 = d.idx.get(595)
                if not (vC(d, s, i595) > vO(d, s, i540))
                    sc.nine := 2
                else
                    array<float> c15h = array.new<float>(6, na)
                    array<float> c15l = array.new<float>(6, na)
                    for gi = 0 to 5
                        int ia = d.idx.get(510 + 15 * gi)
                        int ib = d.idx.get(520 + 15 * gi)
                        float hh = vH(d, s, ia)
                        float ll = vL(d, s, ia)
                        for q = ia to ib
                            hh := math.max(hh, vH(d, s, q))
                            ll := math.min(ll, vL(d, s, q))
                        c15h.set(gi, hh)
                        c15l.set(gi, ll)
                    float bBot = na
                    float bTop = na
                    for gi = 0 to 3
                        float h1v = c15h.get(gi)
                        float l3v = c15l.get(gi + 2)
                        if l3v > h1v + 1.0
                            int made = 555 + 15 * gi
                            bool bad = false
                            if made <= 595
                                for q = d.idx.get(made) to i595
                                    if vC(d, s, q) < h1v
                                        bad := true
                            if vC(d, s, i595) <= l3v
                                bad := true
                            if not bad and (na(bTop) or l3v > bTop)
                                bBot := h1v
                                bTop := l3v
                    if na(bTop)
                        sc.nine := 2
                    else
                        sc.nine := 1
                        sc.nBot := bBot
                        sc.nTop := bTop
                        sc.nTouched := false
                        sc.nI900 := i540
                        sc.nI10 := d.idx.get(600)
        if sc.nine == 1
            int ct = mk + 5
            if ct > 780
                sc.nine := 2
            else
                if vL(d, s, k) <= sc.nTop
                    sc.nTouched := true
                if vC(d, s, k) < sc.nBot
                    sc.nine := 2
                else if sc.nTouched
                    int i10 = sc.nI10
                    int kx = i10
                    for q = i10 to k
                        if vL(d, s, q) < vL(d, s, kx)
                            kx := q
                    int ls = sc.nI900
                    for q = sc.nI900 to kx
                        if vH(d, s, q) > vH(d, s, ls)
                            ls := q
                    int aEnd = math.min(k - 3, kx - 2)
                    int la = -1
                    if aEnd >= ls
                        for a = ls to aEnd
                            if vH(d, s, a + 2) < vL(d, s, a) - 1.0
                                la := a
                    if la >= 0 and vC(d, s, k) > vL(d, s, la) and la != sc.aUsed
                        sc.aUsed := la
                        float lim = vL(d, s, la)
                        float stop = vL(d, s, kx) - 1.0
                        float risk = lim - stop
                        if na(d.pend) and ct >= sc.aFree
                            if risk < 4.0 or risk > 100.0
                                // a stop out of A's limits: no order, and a later turn waits 30 minutes
                                sc.aFree := ct + WAITM
                            else
                                Trade x = newSig(g, d, 0, s, k, mk, lim, stop)
                                x.gBot := sc.nBot
                                x.gTop := sc.nTop
                                x.gBar := d.firstBar + sc.nI900
                                x.fTop := lim
                                x.fBot := vH(d, s, la + 2)
                                out.push(x)
    true

// B · Break & Hold: a strong close through a zone with 1.3x volume; the first retest 2-12 candles later holds it
scanB(St g, Day d, Scan sc, int s, int k, int mk, array<int> zid, array<float> zps, array<Trade> out) =>
    int ct = mk + 5
    float ck = vC(d, s, k)
    float lk = vL(d, s, k)
    float hk = vH(d, s, k)
    for tk in sc.bT
        if tk.alive
            float z = tk.z
            if ck <= z
                tk.alive := false
            else
                float rr = hk - lk
                if k - tk.b >= 2 and lk <= z + TOUCH and tk.top >= z + 3.0 and ck >= z + QQ and rr > 0 and (ck - lk) >= 0.3 * rr
                    tk.alive := false
                    sc.bDone.set(tk.zi, true)
                    for o in sc.bT
                        if o.alive and o.zi == tk.zi
                            o.alive := false
                    if ct >= 590 and ct <= 900
                        int sco = score(d, s, k)
                        if sco >= 2
                            float hi = d.h.get(d.k930)
                            float lo = d.l.get(d.k930)
                            for q = d.k930 to k
                                hi := math.max(hi, d.h.get(q))
                                lo := math.min(lo, d.l.get(q))
                            if (hi - lo) / d.a.get(k) >= 4.0
                                float entry = ck + SLIP
                                float stop = math.min(lk, z) - 2.0
                                float risk = entry - stop
                                if risk >= 3.0 and risk <= 70.0
                                    Trade x = newSig(g, d, 1, s, k, mk, entry, stop)
                                    x.zi := tk.zi
                                    x.zp := z
                                    x.sc := sco
                                    x.vr := d.vr.get(tk.b)
                                    out.push(x)
                else
                    tk.top := math.max(tk.top, hk)
                    if k >= tk.b + 12
                        tk.alive := false
    array<Trk> keep = array.new<Trk>()
    for tk in sc.bT
        if tk.alive
            keep.push(tk)
    sc.bT := keep
    int nz = zid.size()
    if k >= 1 and k >= d.k930 and ct <= 900 and nz > 0
        float ok0 = vO(d, s, k)
        float rng = hk - lk
        if rng > 0 and (ck - ok0) >= 0.5 * rng and (hk - ck) <= 0.3 * rng and rng >= 0.8 * d.a.get(k - 1) and d.vr.get(k) >= VRMIN
            for qi = 0 to nz - 1
                int zi = zid.get(qi)
                float z = zps.get(qi)
                if not sc.bDone.get(zi) and lk <= z and ck >= z + 1.0
                    sc.bT.push(Trk.new(zi, z, k, hk, true))
    true

// C · Gap Breakout: midnight's open above yesterday's close: longs only; the first close from 09:30 outside the night's
// range must break the night's high in that direction
scanC(St g, Day d, Scan sc, int s, int k, int mk, array<Trade> out) =>
    if not sc.cDone and d.k930 >= 0 and k >= d.k930
        if na(d.open00) or na(d.z.get(2)) or na(d.z.get(10))
            sc.cDone := true
        else
            float onh = zv(d, s, 2)
            float onl = zv(d, s, 3)
            float ck = vC(d, s, k)
            if ck > onh or ck < onl
                sc.cDone := true
                int ct = mk + 5
                if ck > onh and s * d.open00 > zv(d, s, 10) and ct >= 575 and ct <= 720
                    int sco = score(d, s, k)
                    if sco >= 2 and d.vr.get(k) >= VRMIN
                        float entry = ck + SLIP
                        float stop = lowView(d, s, math.max(d.k930, k - 2), k) - 1.0
                        float risk = entry - stop
                        if risk >= 4.0 and risk <= 150.0
                            Trade x = newSig(g, d, 2, s, k, mk, entry, stop)
                            x.zi := 2
                            x.zp := onh
                            x.sc := sco
                            out.push(x)
    true

// E1 (New York) and L2 (London) · a zone that holds: price comes to a zone, nothing closes through it, and within 3
// candles a hammer, engulfing or strong candle closes back with 1.3x volume
stepBounce(St g, Day d, Scan sc, int s, int k, int mk, Trk cd, int code, array<Trade> out) =>
    float z = cd.z
    float ck = vC(d, s, k)
    if vL(d, s, k) <= z - 2.0 or ck < z
        cd.alive := false
    else
        string kd = kindOf(d, s, k)
        int ct = mk + 5
        int lo = code == 3 ? 575 : 125
        int hi = code == 3 ? 900 : 475
        if kd != "" and ck >= z + QQ
            cd.alive := false
            if ct >= lo
                array<bool> dn = code == 3 ? sc.e1Done : sc.l2Done
                array<Trk> trs = code == 3 ? sc.e1T : sc.l2T
                dn.set(cd.zi, true)
                for o in trs
                    if o.alive and o.zi == cd.zi
                        o.alive := false
                bool ok = ct <= hi and d.vr.get(k) >= VRMIN
                int sco = 0
                if code == 3
                    ok := ok and ck > s * d.open930
                else
                    sco := score(d, s, k)
                    ok := ok and not na(d.open00) and ck > s * d.open00 and sco >= 2
                float entry = ck + SLIP
                float stop = lowView(d, s, cd.b, k) - 2.0
                float risk = entry - stop
                if ok and risk >= 4.0 and risk <= 60.0
                    Trade x = newSig(g, d, code, s, k, mk, entry, stop)
                    x.zi := cd.zi
                    x.zp := z
                    x.kind := kd
                    x.sc := sco
                    out.push(x)
        else if k >= cd.b + 2
            cd.alive := false
    true

scanBounce(St g, Day d, Scan sc, int s, int k, int mk, array<int> zid, array<float> zps, int code, array<Trade> out) =>
    array<Trk> trs = code == 3 ? sc.e1T : sc.l2T
    for cd in trs
        if cd.alive
            stepBounce(g, d, sc, s, k, mk, cd, code, out)
    int kFrom = code == 3 ? d.k930 : d.k200
    int hi = code == 3 ? 900 : 475
    int nz = zid.size()
    if kFrom >= 0 and k >= math.max(1, kFrom) and mk + 5 <= hi and nz > 0
        array<bool> dn = code == 3 ? sc.e1Done : sc.l2Done
        float cp = vC(d, s, k - 1)
        float lk = vL(d, s, k)
        for qi = 0 to nz - 1
            int zi = zid.get(qi)
            float z = zps.get(qi)
            if not dn.get(zi) and cp >= z + 2.0 and lk <= z + TOUCH
                Trk cd = Trk.new(zi, z, k, na, true)
                trs.push(cd)
                stepBounce(g, d, sc, s, k, mk, cd, code, out)
    array<Trk> keep = array.new<Trk>()
    for cd in trs
        if cd.alive
            keep.push(cd)
    if code == 3
        sc.e1T := keep
    else
        sc.l2T := keep
    true

// E2 · VWAP Snap-back: a gap day (the open 3 ATR or more from yesterday's close); the candle before closed 2.5 ATR or
// more from VWAP against the day; a hammer, engulfing or strong candle closes back on the day's side of the open
scanE2(St g, Day d, int s, int k, int mk, array<Trade> out) =>
    int ct = mk + 5
    if d.k930 >= 0 and k >= d.k930 + 1 and ct >= 590 and ct <= 900 and not na(d.z.get(10))
        if math.abs(d.open930 - d.z.get(10)) >= 3.0 * d.a.get(k)
            float w = s * d.vw.get(k - 1)
            if not na(w) and (w - vC(d, s, k - 1)) >= 2.5 * d.a.get(k - 1)
                string kd = kindOf(d, s, k)
                float ck = vC(d, s, k)
                if kd != "" and ck > s * d.open930
                    float entry = ck + SLIP
                    float stop = math.min(vL(d, s, k - 1), vL(d, s, k)) - 5.0
                    float risk = entry - stop
                    if risk >= 4.0 and risk <= 60.0
                        Trade x = newSig(g, d, 4, s, k, mk, entry, stop)
                        x.kind := kd
                        out.push(x)
    true

// E3 · False Break: price comes to a zone, runs 2 points or more through it (or closes through it) and the first close
// back above it comes within 3 candles; the trend check on its side and the close on the far side of yesterday's close
stepE3(St g, Day d, Scan sc, int s, int k, int mk, Trk cd, array<Trade> out) =>
    float z = cd.z
    float ck = vC(d, s, k)
    if ck >= z + QQ
        cd.alive := false
        float lmin = lowView(d, s, cd.b, k)
        bool byClose = false
        if k > cd.b
            for q = cd.b to k - 1
                if vC(d, s, q) < z
                    byClose := true
        int ct = mk + 5
        if (lmin <= z - 2.0 or byClose) and ct >= 575
            sc.e3Done.set(cd.zi, true)
            for o in sc.e3T
                if o.alive and o.zi == cd.zi
                    o.alive := false
            if ct <= 840
                int sco = score(d, s, k)
                if sco >= 2 and ck < zv(d, s, 10)
                    float entry = ck + SLIP
                    float stop = lmin - 2.0
                    float risk = entry - stop
                    if risk >= 4.0 and risk <= 60.0
                        Trade x = newSig(g, d, 5, s, k, mk, entry, stop)
                        x.zi := cd.zi
                        x.zp := z
                        x.sc := sco
                        out.push(x)
    else if k >= cd.b + 2
        cd.alive := false
    true

scanE3(St g, Day d, Scan sc, int s, int k, int mk, array<int> zid, array<float> zps, array<Trade> out) =>
    for cd in sc.e3T
        if cd.alive
            stepE3(g, d, sc, s, k, mk, cd, out)
    int nz = zid.size()
    if d.k930 >= 0 and k >= math.max(1, d.k930) and mk + 5 <= 840 and nz > 0
        float cp = vC(d, s, k - 1)
        float lk = vL(d, s, k)
        for qi = 0 to nz - 1
            int zi = zid.get(qi)
            float z = zps.get(qi)
            if not sc.e3Done.get(zi) and cp >= z + 2.0 and lk <= z + TOUCH
                Trk cd = Trk.new(zi, z, k, na, true)
                sc.e3T.push(cd)
                stepE3(g, d, sc, s, k, mk, cd, out)
    array<Trk> keep = array.new<Trk>()
    for cd in sc.e3T
        if cd.alive
            keep.push(cd)
    sc.e3T := keep
    true

// L1 · London Breakout: the 18:00 open above yesterday's close: longs only; the first close from 02:00 outside Asia's
// range must break Asia's high in that direction, by 06:00
scanL1(St g, Day d, Scan sc, int s, int k, int mk, array<Trade> out) =>
    if not sc.l1Done and d.k200 >= 0 and k >= d.k200
        if na(d.open18) or na(d.z.get(6)) or na(d.z.get(10)) or mk >= 480
            sc.l1Done := true
        else
            float ash = zv(d, s, 6)
            float asl = zv(d, s, 7)
            float ck = vC(d, s, k)
            if ck > ash or ck < asl
                sc.l1Done := true
                int ct = mk + 5
                if ck > ash and s * d.open18 > zv(d, s, 10) and ct >= 125 and ct <= 360
                    int sco = score(d, s, k)
                    if sco >= 1 and d.vr.get(k) >= VRMIN
                        float entry = ck + SLIP
                        float stop = lowView(d, s, math.max(d.k200, k - 2), k) - 1.0
                        float risk = entry - stop
                        if risk >= 4.0 and risk <= 150.0
                            Trade x = newSig(g, d, 6, s, k, mk, entry, stop)
                            x.zi := 6
                            x.zp := ash
                            x.sc := sco
                            out.push(x)
    true

// the close of a candle: the setups for both sides in the plan's order (A, B, C, E1, E2, E3, L1, L2; long, then short)
closeSignals(St g, Day d, int k, int mk) =>
    bool ny = d.nyOK and d.k930 >= 0 and mk >= 570
    bool ldn = d.k200 >= 0 and mk >= 120 and mk + 5 <= 485
    [zidL, zpsL] = zonesAt(d, 1, mk, false)
    [zidS, zpsS] = zonesAt(d, -1, mk, false)
    [lzidL, lzpsL] = zonesAt(d, 1, mk, true)
    [lzidS, lzpsS] = zonesAt(d, -1, mk, true)
    array<Trade> evs = array.new<Trade>()
    for code = 0 to 7
        if USE.get(code) and (code >= 6 ? ldn : ny)
            for si = 0 to 1
                int s = si == 0 ? 1 : -1
                Scan sc = si == 0 ? d.scL : d.scS
                array<Trade> out = array.new<Trade>()
                if code == 0
                    scanA(g, d, sc, s, k, mk, out)
                else if code == 1
                    scanB(g, d, sc, s, k, mk, si == 0 ? zidL : zidS, si == 0 ? zpsL : zpsS, out)
                else if code == 2
                    scanC(g, d, sc, s, k, mk, out)
                else if code == 3
                    scanBounce(g, d, sc, s, k, mk, si == 0 ? zidL : zidS, si == 0 ? zpsL : zpsS, 3, out)
                else if code == 4
                    scanE2(g, d, s, k, mk, out)
                else if code == 5
                    scanE3(g, d, sc, s, k, mk, si == 0 ? zidL : zidS, si == 0 ? zpsL : zpsS, out)
                else if code == 6
                    scanL1(g, d, sc, s, k, mk, out)
                else
                    scanBounce(g, d, sc, s, k, mk, si == 0 ? lzidL : lzidS, si == 0 ? lzpsL : lzpsS, 7, out)
                for x in out
                    evs.push(x)
    for x in evs
        int s = x.side
        if x.code == 0
            // A: a limit order; the seats and the pause apply when it fills
            x.pending := true
            d.pend := x
            d.ords.push(x)
            d.last := x
            g.drawn.push(x)
            g.flash := bar_index
            int m = math.min(MAXM, math.floor(riskUsd(0) / (PV * x.risk)))
            say(g, alSig, "🔔 NEW SETUP: A LIMIT ORDER · " + head(x) + " · limit order " + fP(s * x.entry) + " · stop " + fP(s * x.stop) + " (" + fPts(x.risk) + " pts) · target " + fP(s * (x.entry + 2.5 * x.risk)) + " (2.5R) · " + str.tostring(m) + " " + CNAME + " · cancel it if price reaches " + fP(s * (x.entry + x.risk)) + " (1R) first, or at " + fHM(x.ct + WAITM) + " · " + fHM(x.ct) + " NY")
        else
            string why = event(g, d, x, x.ct)
            if why == ""
                x.inBar := bar_index + 1
                d.shown.push(x)
                d.last := x
                g.drawn.push(x)
                g.flash := bar_index
                say(g, alSig, "🔔 NEW TRADE · " + head(x) + " · entry " + fP(s * x.entry) + " · stop " + fP(s * x.stop) + " (" + fPts(x.risk) + " pts) · " + planText(x) + " · " + str.tostring(x.m) + " " + CNAME + " · " + fHM(x.ct) + " NY")
            else if why != "taken"
                // a signal the plan does not take (a pause after a loss, no free seat ...): still shown, in grey
                x.skipped := true
                x.note := reasonText(why)
                x.exitBar := bar_index
                d.shown.push(x)
                d.last := x
                g.drawn.push(x)
                say(g, alSkip, "⚪ NOT TAKEN · " + head(x) + " · signal at " + fHM(x.ct) + ", not taken: " + x.note + " · entry would be " + fP(s * x.entry) + " · stop " + fP(s * x.stop))
    true

// ============================================================================ days
// yesterday's volume profile: POC, VAH, VAL (5-point rows, 70% value area) from the regular session's 1-minute candles
profile(array<float> lo, array<float> hi, array<float> vol) =>
    float bin = 5.0
    float base = math.floor(lo.min() / bin) * bin
    float top = math.floor(hi.max() / bin) * bin
    int n = math.round((top - base) / bin) + 1
    array<float> diff = array.new<float>(n + 1, 0.0)
    int off = math.round(base / bin)
    int cnt = lo.size()
    for i = 0 to cnt - 1
        int a = math.max(0, math.min(n - 1, math.floor(lo.get(i) / bin) - off))
        int b = math.max(0, math.min(n - 1, math.floor(hi.get(i) / bin) - off))
        float w = vol.get(i) / (b - a + 1)
        diff.set(a, diff.get(a) + w)
        diff.set(b + 1, diff.get(b + 1) - w)
    array<float> v = array.new<float>(n, 0.0)
    float run = 0.0
    for i = 0 to n - 1
        run += diff.get(i)
        v.set(i, run)
    int poc = 0
    if n > 1
        for i = 1 to n - 1
            if v.get(i) > v.get(poc)
                poc := i
    float total = v.sum()
    float acc = v.get(poc)
    int x = poc
    int y = poc
    while acc < total * 0.7 and (x > 0 or y < n - 1)
        float up = y < n - 1 ? v.get(y + 1) : -1.0
        float dn = x > 0 ? v.get(x - 1) : -1.0
        if up >= dn
            y += 1
            acc += up
        else
            x -= 1
            acc += dn
    [base + poc * bin + bin / 2, base + (y + 1) * bin, base + x * bin]

newScan() =>
    Scan.new(bT = array.new<Trk>(), bDone = array.new<bool>(14, false), e1T = array.new<Trk>(), e1Done = array.new<bool>(14, false), e3T = array.new<Trk>(), e3Done = array.new<bool>(14, false), l2T = array.new<Trk>(), l2Done = array.new<bool>(14, false))

newDay(St g, int sd, bool tradeDay) =>
    string why = not tradeDay ? "No trading today: weekend or market holiday" : not g.prevOK ? "No trades today: the previous day's 1-minute candles are not all on the chart" : ""
    Day d = Day.new(date = sd, tradeDay = tradeDay, valid = tradeDay and g.prevOK, why = why, firstBar = bar_index, m = array.new<int>(), idx = map.new<int, int>(), o = array.new<float>(), h = array.new<float>(), l = array.new<float>(), c = array.new<float>(), a = array.new<float>(), vr = array.new<float>(), vw = array.new<float>(), z = array.new<float>(14, na), zBar = array.new<int>(14, bar_index), sesH = array.new<float>(4, na), sesL = array.new<float>(4, na), sesN = array.new<int>(4, 0), sesDone = array.new<bool>(4, false), scL = newScan(), scS = newScan(), trades = array.new<Trade>(), opened = array.new<Trade>(), shown = array.new<Trade>(), ords = array.new<Trade>(), seen = array.new<string>(), rH = array.new<float>(), rL = array.new<float>(), rV = array.new<float>())
    if g.prevOK
        d.z.set(0, g.prev.get(0))
        d.z.set(1, g.prev.get(1))
        d.z.set(10, g.prev.get(2))
        d.z.set(11, g.prev.get(3))
        d.z.set(12, g.prev.get(4))
        d.z.set(13, g.prev.get(5))
    d

finishDay(St g, Day d) =>
    if d.opened.size() > 0
        array<Trade> cur = d.opened.copy()
        for t in cur
            float rx = (t.side * d.lastC1 - SLIP - t.entry) / t.risk
            settle(g, d, t, t.armed and t.split ? t.leg0 : rx, rx, t.armed and t.split ? t.tFirst : d.lastM1, d.lastM1, "time", d.lastC1 - t.side * SLIP)
    if not na(d.pend)
        Trade p = d.pend
        p.pending := false
        p.note := "not filled"
        d.pend := na
    if d.tradeDay
        if d.rN >= 300
            [poc, vah, val] = profile(d.rL, d.rH, d.rV)
            g.prev.set(0, d.rHi)
            g.prev.set(1, d.rLo)
            g.prev.set(2, d.rClose)
            g.prev.set(3, poc)
            g.prev.set(4, vah)
            g.prev.set(5, val)
            g.prevOK := true
        else
            g.prevOK := false
    true

sessUpdate(Day d, int mk, float h, float l) =>
    for si = 0 to 3
        if mk >= SS_A.get(si) and mk < SS_B.get(si)
            d.sesH.set(si, na(d.sesH.get(si)) ? h : math.max(d.sesH.get(si), h))
            d.sesL.set(si, na(d.sesL.get(si)) ? l : math.min(d.sesL.get(si), l))
            d.sesN.set(si, d.sesN.get(si) + 1)
        if not d.sesDone.get(si) and mk + 5 >= SS_B.get(si)
            d.sesDone.set(si, true)
            if d.sesN.get(si) >= SS_N.get(si)
                d.z.set(SS_H.get(si), d.sesH.get(si))
                d.z.set(SS_L.get(si), d.sesL.get(si))
                d.zBar.set(SS_H.get(si), bar_index)
                d.zBar.set(SS_L.get(si), bar_index)
    true

rthAdd(Day d, array<int> ta, array<float> ha, array<float> la, array<float> ca, array<float> va) =>
    int n = ta.size()
    if n > 0
        for q = 0 to n - 1
            int tq = ta.get(q)
            int mm = hour(tq, TZ) * 60 + minute(tq, TZ)
            if mm >= 570 and mm < 960
                float h = ha.get(q)
                float l = la.get(q)
                d.rHi := na(d.rHi) ? h : math.max(d.rHi, h)
                d.rLo := na(d.rLo) ? l : math.min(d.rLo, l)
                d.rClose := ca.get(q)
                d.rN += 1
                d.rH.push(h)
                d.rL.push(l)
                d.rV.push(va.get(q))
    true

// ============================================================================ drawing
clearDraw(Trade t) =>
    for b in t.bxs
        box.delete(b)
    for ln in t.lns
        line.delete(ln)
    for lb in t.lbs
        label.delete(lb)
    t.bxs.clear()
    t.lns.clear()
    t.lbs.clear()
    true

// the open result of a trade at a price: half of the contracts (rounded up) are banked at the first target once it is
// reached; dollars after the commission
openPnl(Trade t, float px) =>
    int m1 = math.ceil(t.m / 2)
    int mLeft = t.armed and t.split ? t.m - m1 : t.m
    float banked = t.armed and t.split ? m1 * (t.t1p - t.entry) : 0.0
    PV * (banked + mLeft * (t.side * px - t.entry)) - FEE * t.m

// the live tag of an open trade: the open result, then the stop and the next target (the setup is on its entry tag)
liveText(Trade t, float px) =>
    int s = t.side
    float pnl = openPnl(t, px)
    bool atE = math.abs(t.st - t.entry) <= 1e-9
    string stx = atE ? "stop at the entry 🔒" : (t.st > t.stop + 1e-9 ? "trailing stop " : "stop ") + fP(s * t.st)
    string ttx = ""
    if not na(t.t1p) and not t.armed
        ttx := (t.split and t.m > 1 ? "half at " : "target ") + fP(s * t.t1p)
    else if not na(t.t2p)
        ttx := "target " + fP(s * t.t2p)
    else if not na(t.trailFrom) and not t.trailing
        ttx := "trails from " + fP(s * t.trailFrom)
    "● LIVE  " + fUsd(pnl) + "  " + fR(pnl / (PV * t.m * t.risk)) + "\n" + stx + (ttx != "" ? " · " + ttx : "")

// a trade on the chart, glass style, from its entry candle to its exit candle: the target zone and the stop zone (frosted
// glass), the target line in green, the stop line in red, the entry line, the entry tag in the setup's colour (A darkest)
// and, at the exit, the result: green when it won, red when it lost. The open trade is purple, with its live result on the
// right. Hover over the tag or the result for the whole trade.
drawTrade(Trade t) =>
    clearDraw(t)
    int s = t.side
    string lt = LET.get(t.code)
    float e = s * t.entry
    color sh = shadeOf(t.code)
    string tagTx = (s > 0 ? "▲ LONG " : "▼ SHORT ") + lt
    if t.skipped
        // a signal the plan did not take: its letter in grey on the signal candle (hover: why it was not taken)
        if showPast
            t.lbs.push(label.new(t.sigBar, e, lt, yloc = s > 0 ? yloc.belowbar : yloc.abovebar, style = s > 0 ? label.style_label_up : label.style_label_down, color = color.new(C_FLAT, 35), textcolor = C_WHITE, size = size.tiny, tooltip = tipText(t), force_overlay = true))
    else if t.tin < 0
        // A's limit order while it waits: a dotted line at the limit and its tag on the left; once it ends it leaves the chart (the
        // alert says what happened)
        if t.pending
            t.lns.push(line.new(t.sigBar, e, bar_index + 4, e, color = sh, style = line.style_dotted, width = 2, force_overlay = true))
            t.lbs.push(label.new(t.sigBar, e, tagTx + " · limit " + fP(e) + " · until " + fHM(t.ct + WAITM), style = label.style_label_right, color = sh, textcolor = inkOn(sh), size = size.small, tooltip = tipText(t), force_overlay = true))
    else if t.isOpen or showPast
        bool live = t.isOpen
        int lft = t.inBar
        int rgt = live ? bar_index + 4 : math.max(t.exitBar, t.inBar + 1)
        // the target: the final one (the second target, or the only one; B without a zone: +1R, where its trailing starts)
        float tg = not na(t.t2p) ? s * t.t2p : not na(t.t1p) ? s * t.t1p : not na(t.trailFrom) ? s * t.trailFrom : na
        float sp = live ? s * t.st : s * t.stop
        bool won = not live and t.r > 0.05
        bool lost = not live and t.r < -0.05
        color gl = live ? cLive : C_GLASS
        string tip = tipText(t)
        if not na(tg)
            t.bxs.push(box.new(lft, math.max(e, tg), rgt, math.min(e, tg), border_color = color.new(gl, live ? 55 : 76), border_width = 1, bgcolor = color.new(gl, live ? 88 : 92), force_overlay = true))
            t.lns.push(line.new(lft, tg, rgt, tg, color = color.new(cWin, won or live ? 0 : 40), width = won ? 3 : 2, force_overlay = true))
        bool locked = live and (t.st - t.entry) > 1e-9
        bool atEntry = live and math.abs(t.st - t.entry) <= 1e-9
        if locked or atEntry
            // the stop moved to the entry or beyond it: a dashed line, no stop zone
            t.lns.push(line.new(lft, sp, rgt, sp, color = locked ? cWin : C_FLAT, style = line.style_dashed, width = 1, force_overlay = true))
        else
            t.bxs.push(box.new(lft, math.max(e, sp), rgt, math.min(e, sp), border_color = color.new(gl, live ? 72 : 84), border_width = 1, bgcolor = color.new(gl, live ? 94 : 96), force_overlay = true))
            t.lns.push(line.new(lft, sp, rgt, sp, color = color.new(cLoss, lost or live ? 0 : 40), width = lost ? 3 : 2, force_overlay = true))
        // an open trade with two targets, before the first: the first target, dotted
        if live and not na(t.t1p) and not na(t.t2p) and not t.armed
            t.lns.push(line.new(lft, s * t.t1p, rgt, s * t.t1p, color = color.new(cWin, 30), style = line.style_dotted, width = 1, force_overlay = true))
        t.lns.push(line.new(lft, e, rgt, e, color = color.new(C_ENTRYL, 4), width = 2, force_overlay = true))
        t.lbs.push(label.new(lft, e, tagTx, style = label.style_label_right, color = sh, textcolor = inkOn(sh), size = size.small, tooltip = tip, force_overlay = true))
        if live
            t.nowLb := label.new(bar_index, close, "", style = label.style_circle, color = cLive, size = size.tiny, tooltip = tip, force_overlay = true)
            t.lbs.push(t.nowLb)
            t.liveLb := label.new(rgt, close, liveText(t, close), style = label.style_label_left, color = cLive, textcolor = C_WHITE, size = size.small, tooltip = tip, force_overlay = true)
            t.lbs.push(t.liveLb)
        else
            color rc = won ? cWin : lost ? cLoss : C_FLAT
            t.lbs.push(label.new(t.exitBar, t.exitPx, "", style = label.style_circle, color = rc, size = size.tiny, tooltip = tip, force_overlay = true))
            t.lbs.push(label.new(t.exitBar, t.exitPx, fUsd(t.pnl) + "  " + fR(t.r), style = t.exitPx > e ? label.style_label_upper_left : label.style_label_lower_left, color = C_BADGE, textcolor = won ? C_WIN_D : lost ? C_LOSS_D : #5D606B, size = size.small, tooltip = tip, force_overlay = true))
    true

// the trades drawn: the days chosen in the settings, the newest MAXDRAWN of them
cleanup(St g) =>
    array<Trade> keep = array.new<Trade>()
    for t in g.drawn
        if inWindow(t.date)
            keep.push(t)
        else
            clearDraw(t)
    while keep.size() > MAXDRAWN
        clearDraw(keep.shift())
    g.drawn := keep
    true

// the gap of an hour, information only: the 9 o'clock gap's rule (A) for any hour. On 15-minute candles that start at h0-30,
// h0-15, h0 and h0+15: a gap of at least 1 point between the first candle's high and the third one's low in a rising hour
// (the mirror in a falling hour), no 5-minute close back through it before the hour ends, and the hour closing beyond it;
// the highest such gap (the lowest in a falling hour). In prices: [the side, the bottom, the top, the first candle's minute]
hourGap(Day d, int h0) =>
    int s = 0
    float gBot = na
    float gTop = na
    int gA = 0
    if d.idx.contains(h0) and d.idx.contains(h0 + 55)
        int i0 = d.idx.get(h0)
        int i1 = d.idx.get(h0 + 55)
        float mv = d.c.get(i1) - d.o.get(i0)
        s := mv > 0 ? 1 : mv < 0 ? -1 : 0
        if s != 0
            float bBot = na
            float bTop = na
            for gi = 0 to 3
                int a = h0 - 30 + 15 * gi
                bool full = true
                int nq = math.round((h0 + 55 - a) / 5)
                for q = 0 to nq
                    if not d.idx.contains(a + 5 * q)
                        full := false
                if full
                    int ia = d.idx.get(a)
                    int ic = d.idx.get(a + 30)
                    float h1v = vH(d, s, ia)
                    float l3v = vL(d, s, ic)
                    for q = 1 to 2
                        h1v := math.max(h1v, vH(d, s, ia + q))
                        l3v := math.min(l3v, vL(d, s, ic + q))
                    if l3v > h1v + 1.0 and vC(d, s, i1) > l3v
                        bool bad = false
                        if a + 45 <= h0 + 55
                            for q = d.idx.get(a + 45) to i1
                                if vC(d, s, q) < h1v
                                    bad := true
                        if not bad and (na(bTop) or l3v > bTop)
                            bBot := h1v
                            bTop := l3v
                            gA := a
            if na(bTop)
                s := 0
            else
                gBot := math.min(s * bBot, s * bTop)
                gTop := math.max(s * bBot, s * bTop)
    [s, gBot, gTop, gA]

// ============================================================================ the candles
float atr14 = ta.sma(ta.tr(true), 14)
float vma20 = ta.sma(volume, 20)
float vrNow = nz(vma20[1]) > 0 ? volume / vma20[1] : 1.0
// about the chart's visible height: the range of the last 150 candles (to keep the day lines' tags from covering each other)
float visRange = ta.highest(high, 150) - ta.lowest(low, 150)
[t1a, o1a, h1a, l1a, c1a, v1a] = request.security_lower_tf(syminfo.tickerid, "1", [time, open, high, low, close, volume])

bool tfOK = timeframe.period == "5"
int modNow = hour(time, TZ) * 60 + minute(time, TZ)
int mkNow = modNow < 1080 ? modNow : modNow - 1440
int sdNow = dateOf(time + 21600000)
int dowNow = dayofweek(time + 21600000, TZ)
bool tradeDayNow = dowNow >= dayofweek.monday and dowNow <= dayofweek.friday and not HOL.includes(sdNow)
int lastSd = dateOf(last_bar_time + 21600000)
if lastSd != lastSdV
    lastSdV := lastSd
    prevSdV := prevTradeDay(lastSd)
    prev2SdV := prevTradeDay(prevSdV)
int lastMod = hour(last_bar_time, TZ) * 60 + minute(last_bar_time, TZ)
bool earlyNow = lastMod >= 1080 or lastMod < 120
bool wentLive = earlyV and not earlyNow
earlyV := earlyNow

var St ST = St.new(prev = array.new<float>(6, na), drawn = array.new<Trade>(), msg = array.new<string>())
var Day D = na
var Day DP = na
// the hour gaps and the session lines on the chart (the newest ones)
var array<box> HG = array.new<box>()
var array<line> SL = array.new<line>()
var array<label> SB = array.new<label>()
var bool testSent = false
string TIP_ASIA = "Asia session: 18:00 – 02:00 New York time\nIts high and low (ASH, ASL) are levels for London's L2 and for New York\nLondon 02:00 – 08:00 · New York 09:30 – 16:00"
string TIP_LDN = "London session: 02:00 – 08:00 New York time\nThe plan's London setups: L1 until 06:00 and L2 until 07:55; London trades close by 08:00\nAsia 18:00 – 02:00 · New York 09:30 – 16:00"
string TIP_NY = "New York session: 09:30 – 16:00 New York time\nThe plan's New York setups: 09:30 – 15:00; New York trades close by 15:55\nAsia 18:00 – 02:00 · London 02:00 – 08:00"

if tfOK and barstate.isconfirmed
    // a new session at 18:00 New York: finish yesterday (its levels for today), start the day
    if na(D) or sdNow != D.date
        if not na(D)
            finishDay(ST, D)
            if inWindow(D.date)
                for t in D.shown
                    drawTrade(t)
            DP := D
        D := newDay(ST, sdNow, tradeDayNow)
        cleanup(ST)
    else if wentLive
        cleanup(ST)
    int n1 = t1a.size()
    // the day's trades need its 1-minute candles: checked at the first candle from 02:00
    if D.valid and not D.m1Checked and mkNow >= 120
        D.m1Checked := true
        if n1 == 0
            D.valid := false
            D.why := "No trades today: no 1-minute candles for today on the chart"
    // 1) the minutes of this candle: A's limit order and the open trades
    if D.valid and n1 > 0 and (D.opened.size() > 0 or not na(D.pend))
        processMinutes(ST, D, t1a, h1a, l1a, c1a, mkNow, low, high)
    // 2) the candle closes: today's candles, the sessions, VWAP, the regular session for tomorrow's levels
    int k = D.m.size()
    D.m.push(mkNow)
    D.idx.put(mkNow, k)
    D.o.push(open)
    D.h.push(high)
    D.l.push(low)
    D.c.push(close)
    D.a.push(atr14)
    D.vr.push(vrNow)
    sessUpdate(D, mkNow, high, low)
    if k == 0 and mkNow < -300
        D.open18 := open
    if mkNow == 0
        D.open00 := open
    if mkNow >= 120 and D.k200 < 0
        D.k200 := k
    bool first930 = mkNow >= 570 and D.k930 < 0
    if first930
        D.k930 := k
        D.open930 := open
        if mkNow != 570
            D.nyOK := false
    if D.k930 >= 0
        D.pv += (high + low + close) / 3 * volume
        D.vv += volume
        D.vw.push(D.pv / math.max(D.vv, 1e-12))
    else
        D.vw.push(na)
    if mkNow >= 570 and mkNow < 960
        rthAdd(D, t1a, h1a, l1a, c1a, v1a)
    if first930 and D.valid
        if n1 == 0
            D.valid := false
            D.why := "No trades today: no 1-minute candles for today on the chart"
        else if D.sesN.get(2) == 0
            D.valid := false
            D.why := "No night session on the chart: turn on extended trading hours"
    // the session lines: a faint line where a session starts or ends, and its name (hover: its hours)
    if showSess
        int sb = mkNow == -360 ? 0 : mkNow == 120 ? 1 : mkNow == 480 ? 2 : mkNow == 570 ? 3 : mkNow == 960 ? 4 : -1
        if sb >= 0
            color sc = sb == 0 ? cAsia : sb <= 2 ? cLdn : cNy
            SL.push(line.new(bar_index, low, bar_index, low + 1.0, extend = extend.both, color = color.new(sc, sb == 2 or sb == 4 ? 72 : 55), style = line.style_dotted, width = 1, force_overlay = true))
            if sb == 0 or sb == 1 or sb == 3
                SB.push(label.new(bar_index, high, sb == 0 ? "ASIA" : sb == 1 ? "LONDON" : "NEW YORK", yloc = yloc.abovebar, style = label.style_label_down, color = C_NONE, textcolor = color.new(sc, 20), size = size.tiny, tooltip = sb == 0 ? TIP_ASIA : sb == 1 ? TIP_LDN : TIP_NY, force_overlay = true))
            while SL.size() > 40
                line.delete(SL.shift())
            while SB.size() > 24
                label.delete(SB.shift())
    // the gap of the hour that ends at this close (information only)
    if showGaps and (mkNow + 5) % 60 == 0 and inWindow(D.date)
        int h0 = mkNow - 55
        [gs, gb, gt, ga] = hourGap(D, h0)
        if gs != 0
            HG.push(box.new(D.firstBar + D.idx.get(ga + 15), gt, bar_index + 1, gb, border_color = color.new(C_GLASS, 55), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(C_GLASS, 92), text = fHM(h0) + " gap " + (gs > 0 ? "▲" : "▼"), text_size = size.tiny, text_color = color.new(C_GAPT, 10), text_halign = text.align_right, text_valign = text.align_center, force_overlay = true))
            if h0 == 540
                D.gap9 := HG.last()
                D.gap9S := gs
            while HG.size() > 100
                box.delete(HG.shift())
    // 3) A's limit order: its 30 minutes are over at this close
    if not na(D.pend) and D.pend.ct + WAITM <= mkNow + 5
        endOrder(ST, D, D.pend, D.pend.ct + WAITM, "not filled in 30 minutes", "limit order not filled in 30 minutes: cancel it · " + fHM(D.pend.ct + WAITM) + " NY")
    // 4) the signals of this close: London 02:00 - 08:00, New York 09:30 - 15:00 (a signal the plan cannot take, in a pause
    // or with no free seat, still shows, as not taken)
    if D.valid and ((mkNow >= 120 and mkNow + 5 <= 485) or (mkNow >= 570 and mkNow + 5 <= 900))
        closeSignals(ST, D, k, mkNow)
    // a test alert, once, at the first close after the alert starts
    if alTest and barstate.isrealtime and not testSent
        testSent := true
        say(ST, true, "🔔 TEST · ST Nasdaq: this is how the plan's alerts come, at the close of a 5-minute candle · " + fHM(mkNow + 5) + " NY")
    // 5) one alert with everything this candle brought
    if ST.msg.size() > 0
        alert(ST.msg.join("\n"), alert.freq_once_per_bar_close)
        ST.msg.clear()

// ============================================================================ the candles' colours, VWAP, the volume, the sessions
// the candles in the indicator's colours, the whole candle: body, wick and border (the volume takes the same ones)
color barC = close >= open ? cUp : cDn
barcolor(colBars ? barC : na, title = "Candles")
plotcandle(colBars ? open : na, colBars ? high : na, colBars ? low : na, colBars ? close : na, "Candles", color = barC, wickcolor = barC, bordercolor = barC, display = display.pane, force_overlay = true)

// VWAP as the course uses it, from 09:30; drawn in New York hours only (09:30 - 16:00), with a soft glow
bool vwOn = tfOK and mkNow >= 570 and mkNow < 960
var float vwS = 0.0
var float vwQ = 0.0
if vwOn and (not vwOn[1] or sdNow != nz(sdNow[1]))
    vwS := 0.0
    vwQ := 0.0
if vwOn
    vwS += (high + low + close) / 3 * volume
    vwQ += volume
float vwNow = showVwap and vwOn and vwQ > 0 ? vwS / vwQ : na
plot(vwNow, "VWAP glow", color = color.new(cVwap, 88), linewidth = 6, style = plot.style_linebr, display = display.pane, force_overlay = true)
plot(vwNow, "VWAP glow 2", color = color.new(cVwap, 74), linewidth = 3, style = plot.style_linebr, display = display.pane, force_overlay = true)
plot(vwNow, "VWAP", color = cVwap, linewidth = 1, style = plot.style_linebr, format = format.price, precision = 2, force_overlay = true)

// today's candles with a new trade or A's limit order: a soft purple background, easy to spot
bgcolor(tfOK and not na(D) and D.date == lastSdV and ST.flash == bar_index ? color.new(cLive, 88) : na, title = "New trade today", force_overlay = true)

// the sessions: a thin band at the top of the chart in each session's colour
bool inAsia = showSess and tfOK and mkNow >= -360 and mkNow < 120
bool inLdn = showSess and tfOK and mkNow >= 120 and mkNow < 480
bool inNy = showSess and tfOK and mkNow >= 570 and mkNow < 960
plotshape(inAsia, "Asia", style = shape.square, location = location.top, color = color.new(cAsia, 50), size = size.tiny, display = display.pane, force_overlay = true)
plotshape(inLdn, "London", style = shape.square, location = location.top, color = color.new(cLdn, 50), size = size.tiny, display = display.pane, force_overlay = true)
plotshape(inNy, "New York", style = shape.square, location = location.top, color = color.new(cNy, 50), size = size.tiny, display = display.pane, force_overlay = true)

// the volume in the indicator's own pane, as TradingView shows it, in the candles' colours. Its measure: the line is the
// average of the 20 candles before; a dot over a bar marks 1.3 times that average or more (the course's volume check); the
// tag on the last candle gives its volume and how many times the average it is, and so does the status line for any candle
float vAvg = nz(vma20[1])
plot(showVol ? volume : na, "Volume", color = barC, style = plot.style_columns)
plot(showVol and vAvg > 0 ? vAvg : na, "Average of the 20 candles before", color = color.new(C_ENTRYL, 40), linewidth = 1)
plot(showVol and vrNow >= VRMIN ? volume * 1.06 : na, "Volume check: 1.3 times the average or more", color = C_ENTRYL, style = plot.style_circles, linewidth = 3, display = display.pane)
plot(showVol ? vrNow : na, "Times the average", color = C_ENTRYL, display = display.status_line + display.data_window)
var label volLb = na
if showVol and barstate.islast
    label.delete(volLb)
    volLb := label.new(bar_index, volume, "VOLUME " + str.tostring(volume, format.volume) + " · " + str.tostring(vrNow, "0.00") + "× the average" + (vrNow >= VRMIN ? "  ✓ 1.3×" : ""), style = label.style_label_left, color = K_BG, textcolor = vrNow >= VRMIN ? #FFD54F : K_TXT, size = size.small, text_formatting = text.format_bold, force_overlay = false)

// ============================================================================ the day lines
var array<line> DL = array.new<line>()
var array<label> DB = array.new<label>()
var array<box> DX = array.new<box>()
if tfOK and showLines and barstate.isconfirmed and not na(D) and D.date == lastSdV and bar_index >= last_bar_index - 1
    for xl in DL
        line.delete(xl)
    for xb in DB
        label.delete(xb)
    for xx in DX
        box.delete(xx)
    DL.clear()
    DB.clear()
    DX.clear()
    // zones within 2 points share a line (the course merges them); each tag says what its zone is, from the highest price
    // down. Yesterday's POC is yellow, the value area amber, every other zone blue
    array<float> gpx = array.new<float>()
    array<string> gnm = array.new<string>()
    array<string> gtp = array.new<string>()
    array<int> gct = array.new<int>()
    array<bool> doneZ = array.new<bool>(14, false)
    for i = 0 to 13
        float p = D.z.get(i)
        if not na(p) and not doneZ.get(i)
            string names = ZN.get(i) + " (" + ZSHORT.get(i) + ")"
            string tip = ZN.get(i) + ": " + ZTIP.get(i)
            int cat = i == 11 ? 2 : i == 12 or i == 13 ? 1 : 0
            doneZ.set(i, true)
            for q = 0 to 13
                float pq = D.z.get(q)
                if q != i and not doneZ.get(q) and not na(pq) and math.abs(pq - p) <= MERGE
                    names += " · " + ZN.get(q) + " (" + ZSHORT.get(q) + ")"
                    tip += "\n" + ZN.get(q) + ": " + ZTIP.get(q)
                    cat := math.max(cat, q == 11 ? 2 : q == 12 or q == 13 ? 1 : 0)
                    doneZ.set(q, true)
            color lc = cat == 2 ? cPoc : cat == 1 ? cVa : cLvl
            DL.push(line.new(D.zBar.get(i), p, bar_index + 15, p, color = color.new(lc, 10), style = line.style_solid, width = cat == 2 ? 2 : 1, force_overlay = true))
            int at = 0
            while at < gpx.size() and gpx.get(at) > p
                at += 1
            gpx.insert(at, p)
            gnm.insert(at, names + " " + fP(p))
            gtp.insert(at, tip)
            gct.insert(at, cat)
    // a tag line is about 3.5% of the chart's height: zones of the same colour closer than that share one tag, and a tag
    // that would touch the one above it moves down just enough (the line itself stays at its price)
    float lgap = visRange * 0.035
    int ng = gpx.size()
    int g0 = 0
    float lastBot = na
    while g0 < ng
        int g1 = g0
        bool prof = gct.get(g0) > 0
        while g1 + 1 < ng and (gct.get(g1 + 1) > 0) == prof and gpx.get(g0) - gpx.get(g1 + 1) < lgap
            g1 += 1
        string txt = ""
        string tip = ""
        int best = 0
        float psum = 0.0
        for q = g0 to g1
            txt += (q > g0 ? "\n" : "") + gnm.get(q)
            tip += (q > g0 ? "\n" : "") + gtp.get(q)
            best := math.max(best, gct.get(q))
            psum += gpx.get(q)
        float h = (g1 - g0 + 1) * lgap
        float y = psum / (g1 - g0 + 1)
        if not na(lastBot) and y + h / 2 > lastBot
            y := lastBot - h / 2
        lastBot := y - h / 2
        color lc = best == 2 ? cPoc : best == 1 ? cVa : cLvl
        DB.push(label.new(bar_index + 15, y, txt, style = label.style_label_left, color = color.new(lc, 15), textcolor = best > 0 ? C_INK : C_WHITE, size = size.small, tooltip = tip, force_overlay = true))
        g0 := g1 + 1
    // without the hour gaps: the 9 o'clock gap of A as its own box
    if not showGaps
        for si = 0 to 1
            Scan sc = si == 0 ? D.scL : D.scS
            int s = si == 0 ? 1 : -1
            if DX.size() == 0 and not na(sc.nTop) and not na(sc.nBot) and sc.nI900 >= 0
                float gb = s * sc.nBot
                float gt = s * sc.nTop
                DX.push(box.new(D.firstBar + sc.nI900, math.max(gb, gt), math.max(bar_index, D.firstBar + sc.nI10), math.min(gb, gt), border_color = color.new(cLvl, 45), bgcolor = color.new(cLvl, 90), text = "9 o'clock gap " + fP(math.min(gb, gt)) + " – " + fP(math.max(gb, gt)), text_size = size.small, text_color = cLvl, text_halign = text.align_left, text_valign = text.align_top, force_overlay = true))

// the 9 o'clock gap while A watches it (10:00 - 13:00): its box runs on to the last candle
if tfOK and showGaps and barstate.isconfirmed and not na(D) and D.date == lastSdV and bar_index >= last_bar_index - 1 and not na(D.gap9)
    bool watchA = (D.gap9S > 0 ? D.scL.nine : D.scS.nine) == 1
    if watchA
        box.set_right(D.gap9, bar_index + 1)
    box.set_text(D.gap9, "09:00 gap " + (D.gap9S > 0 ? "▲" : "▼") + (watchA ? " · A watches it until 13:00" : ""))

// the trades on the chart, drawn after the day lines so that their tags stay on top. An open trade is redrawn on the
// last candles only; a finished one once, at its exit
if tfOK and barstate.isconfirmed and not na(D) and inWindow(D.date)
    bool nearEnd = bar_index >= last_bar_index - 1
    for t in D.shown
        if t.exitBar == bar_index or (t.isOpen and nearEnd)
            drawTrade(t)
    for t in D.ords
        if t.tin < 0 and ((t.pending and nearEnd) or (not t.pending and t.exitBar == bar_index))
            drawTrade(t)

// the open trades' live result, at every price update of the last candle
if barstate.islast and tfOK and not na(D) and D.date == lastSdV
    for t in D.opened
        if not na(t.liveLb)
            label.set_text(t.liveLb, liveText(t, close))
            label.set_y(t.liveLb, close)
        if not na(t.nowLb)
            label.set_xy(t.nowLb, bar_index, close)

// ============================================================================ tables
// the target of a trade, short (for the last setup's card)
targetText(Trade x) =>
    int s = x.side
    string out = "—"
    if x.code == 0
        out := fP(s * (x.entry + 2.5 * x.risk)) + " (2.5R) for the whole trade"
    else if x.tin >= 0
        if x.code == 1
            out := x.split ? "half at " + x.tgtName + " " + fP(s * x.t1p) + ", then trail" : "trail from +1R " + fP(s * x.trailFrom)
        else if x.code == 2
            out := fP(s * x.t2p) + " (4R) · stop to the entry at +1.5R"
        else if x.code == 3 or x.code == 5
            out := "half at " + fP(s * x.t1p) + ", then trail"
        else
            out := "half at " + fP(s * x.t1p) + " (1R) · the rest at " + fP(s * x.t2p) + " (3R)"
    out

// one row of the last setup's card
boxRow(table tb, int row, string k, string v, color vc, string tip) =>
    table.cell(tb, 0, row, k, text_color = K_SUB, text_halign = text.align_left, text_size = size.small, text_formatting = text.format_bold, tooltip = tip)
    table.cell(tb, 1, row, v, text_color = vc, text_halign = text.align_left, text_size = size.small, text_formatting = text.format_bold, tooltip = tip)
    true

// what the plan is doing now, in full (the hover of the panel's last cell)
statusText(Day d, int mk) =>
    string out = ""
    int now = mk + 5
    if na(d)
        out := "Loading"
    else if not d.valid
        out := d.why != "" ? d.why : "No trades today"
    else
        array<string> parts = array.new<string>()
        if not na(d.pend)
            parts.push("A limit " + fP(d.pend.side * d.pend.entry) + " waits until " + fHM(d.pend.ct + WAITM))
        if d.opened.size() >= SEATS
            parts.push("Both seats in use: new signals are not taken until one is free")
        else if now < d.busy
            parts.push("Pause after a loss until " + fHM(d.busy))
        array<string> ws = array.new<string>()
        if mk < 120 or now > 900
            ws.push(now > 900 ? "No new signals after 15:00" : "Asia: the plan starts at 02:00")
        else if now <= 485
            if USE.get(6) and not (d.scL.l1Done and d.scS.l1Done) and not d.usedL1 and now <= 360
                ws.push("L1 until 06:00")
            if USE.get(7) and now <= 475
                ws.push("L2 until 07:55")
            if ws.size() == 0
                ws.push("No London setup can come now · New York starts at 09:30")
            else
                ws.set(0, "London: watching " + ws.get(0))
        else if mk < 570
            ws.push("New York starts at 09:30")
        else
            array<string> w = array.new<string>()
            if USE.get(0) and not d.usedA and now <= 780 and not (d.scL.nine == 2 and d.scS.nine == 2 and na(d.pend))
                w.push("A until 13:00")
            if USE.get(1)
                w.push("B until 15:00")
            if USE.get(2) and not d.usedC and not (d.scL.cDone and d.scS.cDone) and now <= 720
                w.push("C until 12:00")
            if USE.get(3)
                w.push("E1 until 15:00")
            if USE.get(4)
                w.push("E2 until 15:00")
            if USE.get(5) and now <= 840
                w.push("E3 until 14:00")
            ws.push(w.size() > 0 ? "Watching: " + w.join(" · ") : "No setup can come now")
        parts.push(ws.join(" · "))
        out := parts.join(" · ")
    out

// what can come next, short (the panel's last cell)
nextText(Day d, int mk) =>
    string out = ""
    int now = mk + 5
    if na(d)
        out := "Loading"
    else if not d.valid
        out := d.why != "" ? d.why : "No trades today"
    else
        array<string> w = array.new<string>()
        if mk < 120 or now > 900
            out := now > 900 ? "No new signals after 15:00" : "London from 02:00"
        else if now <= 485
            if USE.get(6) and not (d.scL.l1Done and d.scS.l1Done) and not d.usedL1 and now <= 360
                w.push("L1")
            if USE.get(7) and now <= 475
                w.push("L2")
            out := w.size() > 0 ? "NEXT  " + w.join(" · ") : "New York from 09:30"
        else if mk < 570
            out := "New York from 09:30"
        else
            if USE.get(0) and not d.usedA and now <= 780 and not (d.scL.nine == 2 and d.scS.nine == 2 and na(d.pend))
                w.push("A")
            if USE.get(1)
                w.push("B")
            if USE.get(2) and not d.usedC and not (d.scL.cDone and d.scS.cDone) and now <= 720
                w.push("C")
            if USE.get(3)
                w.push("E1")
            if USE.get(4)
                w.push("E2")
            if USE.get(5) and now <= 840
                w.push("E3")
            out := w.size() > 0 ? "NEXT  " + w.join(" · ") : "No setup can come now"
        if not na(d.pend)
            out := "A LIMIT " + fP(d.pend.side * d.pend.entry) + " until " + fHM(d.pend.ct + WAITM) + " · " + out
        if d.opened.size() >= SEATS
            out := "BOTH SEATS IN USE · " + out
        else if now < d.busy
            out := "PAUSE until " + fHM(d.busy) + " · " + out
    out

// the power of a side: three squares, lit for each check in its favour (net of the checks against it)
meter(int n) =>
    n >= 3 ? "■■■" : n == 2 ? "■■□" : n == 1 ? "■□□" : "□□□"

// one check's vote: up for longs, down for shorts
vote(int v) =>
    v > 0 ? "▲" : v < 0 ? "▼" : "–"

string STAT_TIP = "Tested on the plan's own rules with every signal taken (no daily trade or loss limit; the 15-minute pause after a loss and the two seats stay), at the course risk: $500 New York, $300 London, MNQ, $1 a contract.\nLast 12 months, 1 Oct 2025 – 30 Sep 2026, the year the plan was built on: 259 trades · 73.4% won · profit factor 3.66 · +$73,107 (New York +$64,247, London +$8,859) · worst drawdown $1,947.\nThe years before, Jan 2022 – Sep 2025: 1,478 trades · 49.8% won · profit factor 1.07 · +$22,670 · worst drawdown $24,460.\nYour own results can be different."
string TIP_SESS = "New York time.\nAsia 18:00 – 02:00 · London 02:00 – 08:00 · New York 09:30 – 16:00\nThe plan trades London 02:00 – 08:00 and New York 09:30 – 15:00."
string TIP_POWER = "The plan's trend check on the last closed 5-minute candle, three parts:\n• swings: the last two swing highs and swing lows of the last 36 candles are both higher (▲) or both lower (▼)\n• vs POC: the last 6 closes are all above (▲) or all below (▼) yesterday's POC\n• bodies: over the last 12 candles the green bodies are at least 1.5 times the red ones (▲), or the other way round (▼)\nPower: the parts for a side minus the parts against it. B, C, E3 and L2 trade a side only at 2 of 3 or more; L1 needs 1. A, E1 and E2 do not use it."

// extended trading hours: candles of the night (18:00 - 09:30) on the chart
var bool nightSeen = false
if tfOK and barstate.isconfirmed and mkNow < 570
    nightSeen := true

var table tInfo = na
var table tKey = na
var table tToday = na
if barstate.islast
    if not na(tInfo)
        table.delete(tInfo)
    if not na(tKey)
        table.delete(tKey)
    if not na(tToday)
        table.delete(tToday)
    string pos = infoPos == P1 ? position.bottom_right : infoPos == P2 ? position.bottom_left : position.top_right
    string cpos = infoPos == P1 ? position.bottom_left : position.bottom_right
    // text sizes: S, M (the default) or L; the second size is for the smaller lines
    string TS = infoSize == Z0 ? size.small : infoSize == Z2 ? size.large : size.normal
    string TS2 = infoSize == Z0 ? size.tiny : infoSize == Z2 ? size.normal : size.small
    bool showPrev = not na(D) and not na(DP) and (mkNow < 120 or not D.tradeDay)
    Day TD = showPrev ? DP : D
    if not tfOK
        tInfo := table.new(pos, 1, 1, bgcolor = K_WARN, frame_color = K_TIME, frame_width = 1, force_overlay = true)
        table.cell(tInfo, 0, 0, "ShotaTrades Nasdaq Playbook works on the 5-minute chart", text_color = K_TXT, text_size = size.normal, text_formatting = text.format_bold)
    else
        // the panel: the tested 12 months on top; New York time, today's result and the trades; then closed and open, and
        // what can come next
        if showInfo
            tInfo := table.new(pos, 3, 8, bgcolor = C_NONE, frame_width = 0, border_width = 2, border_color = C_NONE, force_overlay = true)
            int row = 0
            if showStats
                string st = "SHOTATRADES · TESTED, LAST 12 MONTHS (OCT 2025 – SEP 2026)\n259 trades · 73.4% won · +$73,107 at the course risk ($500 NY · $300 London)"
                if rNY != 500 or rLD != 300
                    st += "\nAt your risk ($" + str.tostring(rNY, "#,##0") + " NY · $" + str.tostring(rLD, "#,##0") + " London): about " + fUsd(64247.0 * rNY / 500.0 + 8859.0 * rLD / 300.0)
                table.cell(tInfo, 0, row, st, text_color = K_TXT, bgcolor = K_HEAD, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold, tooltip = STAT_TIP)
                table.merge_cells(tInfo, 0, row, 2, row)
                row += 1
            float realized = 0.0
            float openP = 0.0
            int nW = 0
            int nL = 0
            int nO = 0
            int nT = 0
            string dayTip = ""
            if not na(TD)
                nT := TD.trades.size()
                for t in TD.trades
                    string nm = fHM(t.tin) + "  " + LET.get(t.code) + (t.side > 0 ? " ▲ LONG" : " ▼ SHORT")
                    if t.isOpen
                        float op = openPnl(t, close)
                        nO += 1
                        openP += op
                        dayTip += (dayTip != "" ? "\n" : "") + nm + " · live " + fUsd(op)
                    else
                        realized += t.pnl
                        nW += t.r > 0.05 ? 1 : 0
                        nL += t.r < -0.05 ? 1 : 0
                        dayTip += (dayTip != "" ? "\n" : "") + nm + " · " + (t.r > 0.05 ? "won " : t.r < -0.05 ? "lost " : "even ") + fUsd(t.pnl) + " · " + fR(t.r)
            float total = realized + openP
            string dayW = showPrev ? str.upper(fDate(TD.date)) : "TODAY"
            table.cell(tInfo, 0, row, "NY " + str.format_time(timenow, "HH:mm", TZ), text_color = C_WHITE, bgcolor = K_TIME, text_size = TS, text_formatting = text.format_bold, tooltip = TIP_SESS)
            table.cell(tInfo, 1, row, dayW + "  " + fUsd(total), text_color = nT == 0 ? C_WHITE : total >= 0 ? C_INK : C_WHITE, bgcolor = nT == 0 ? K_TIME : total >= 0 ? cWin : cLoss, text_size = TS, text_formatting = text.format_bold, tooltip = dayTip != "" ? dayTip : "No trades yet")
            table.cell(tInfo, 2, row, str.tostring(nT) + (nT == 1 ? " TRADE · " : " TRADES · ") + str.tostring(nW) + " WON · " + str.tostring(nL) + " LOST" + (nO > 0 ? " · " + str.tostring(nO) + " LIVE" : ""), text_color = C_WHITE, bgcolor = nO > 0 ? cLive : K_BG, text_halign = text.align_left, text_size = TS, text_formatting = text.format_bold, tooltip = dayTip != "" ? dayTip : "No trades yet")
            row += 1
            table.cell(tInfo, 0, row, "closed " + fUsd(realized) + " · open " + fUsd(openP), text_color = K_TXT, bgcolor = K_BG, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold)
            table.merge_cells(tInfo, 0, row, 1, row)
            table.cell(tInfo, 2, row, nextText(D, mkNow), text_color = #D6E4FF, bgcolor = K_BG, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold, tooltip = statusText(D, mkNow))
            row += 1
            if syminfo.root != "NQ" and syminfo.root != "MNQ"
                table.cell(tInfo, 0, row, "Made for the Nasdaq-100 futures: NQ or MNQ", text_color = K_TXT, bgcolor = K_WARN, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold)
                table.merge_cells(tInfo, 0, row, 2, row)
                row += 1
            if liveIn
                bool rtNow = barstate.isrealtime
                bool late = rtNow and timenow - time_close > 120000
                array<string> ck = array.from(not rtNow ? "Real-time data: checked while the market is open" : late ? "✗ Delayed data: signals come about 10 minutes late. Live trading needs real-time CME data" : "✓ Real-time data", nightSeen ? "✓ Extended trading hours" : "✗ Turn on extended trading hours: London and the night levels need them", "Alerts need a TradingView plan with indicator alerts.\nCreate one on ST Nasdaq: Any alert() function call, Once per bar close")
                array<bool> bad = array.from(late, not nightSeen, false)
                for i = 0 to 2
                    table.cell(tInfo, 0, row, ck.get(i), text_color = K_TXT, bgcolor = bad.get(i) ? K_WARN : K_BG, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold)
                    table.merge_cells(tInfo, 0, row, 2, row)
                    row += 1
        // top left: the setups' colour (darker = stronger) and, under it, the power of longs and shorts from the plan's
        // three trend checks on the last closed candle
        if showKey and not na(D) and D.m.size() > 0
            tKey := table.new(position.top_left, 10, 5, bgcolor = C_NONE, frame_width = 0, border_width = 2, border_color = C_NONE, force_overlay = true)
            int r0 = 0
            if keyGap > 0
                table.cell(tKey, 0, 0, "", bgcolor = C_NONE, height = keyGap)
                table.merge_cells(tKey, 0, 0, 9, 0)
                r0 := 1
            table.cell(tKey, 0, r0, "SETUPS", text_color = K_SUB, bgcolor = K_HEAD, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold)
            for c = 0 to 7
                color shc = shadeOf(c)
                table.cell(tKey, c + 1, r0, LET.get(c), text_color = inkOn(shc), bgcolor = shc, text_size = TS2, text_formatting = text.format_bold, tooltip = LET.get(c) + " · " + SNAME.get(c) + (LDN.get(c) ? " · London" : " · New York"))
            table.cell(tKey, 9, r0, "darker = stronger", text_color = K_SUB, bgcolor = K_HEAD, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold)
            [p1, p2, p3] = scoreParts(D, 1, D.m.size() - 1)
            int pw = p1 + p2 + p3
            int pL = math.max(pw, 0)
            int pS = math.max(-pw, 0)
            table.cell(tKey, 0, r0 + 1, "POWER", text_color = K_SUB, bgcolor = K_HEAD, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold, tooltip = TIP_POWER)
            table.merge_cells(tKey, 0, r0 + 1, 0, r0 + 2)
            table.cell(tKey, 1, r0 + 1, "▲ LONG    " + meter(pL) + "   " + str.tostring(pL) + "/3" + (pL >= 2 ? " · allowed" : ""), text_color = pL >= 2 ? cWin : K_SUB, bgcolor = K_BG, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold, tooltip = TIP_POWER)
            table.merge_cells(tKey, 1, r0 + 1, 9, r0 + 1)
            table.cell(tKey, 1, r0 + 2, "▼ SHORT   " + meter(pS) + "   " + str.tostring(pS) + "/3" + (pS >= 2 ? " · allowed" : ""), text_color = pS >= 2 ? cLoss : K_SUB, bgcolor = K_BG, text_halign = text.align_left, text_size = TS2, text_formatting = text.format_bold, tooltip = TIP_POWER)
            table.merge_cells(tKey, 1, r0 + 2, 9, r0 + 2)
            table.cell(tKey, 0, r0 + 3, "swings " + vote(p1) + "   vs POC " + vote(p2) + "   bodies " + vote(p3) + "   ·   B C E3 L2 need 2/3 · L1 needs 1", text_color = K_SUB, bgcolor = K_HEAD, text_halign = text.align_left, text_size = TS2, tooltip = TIP_POWER)
            table.merge_cells(tKey, 0, r0 + 3, 9, r0 + 3)
        // the last setup of the day, as a card: green won, red lost, purple open or waiting, grey not taken
        Trade LT = na(TD) ? na : TD.last
        if showToday and not na(LT)
            int s = LT.side
            bool fin = LT.tin >= 0 and not LT.isOpen and LT.texit >= 0
            color hc = LT.skipped ? C_FLAT : (LT.tin < 0 or LT.isOpen) ? cLive : LT.r > 0.05 ? cWin : LT.r < -0.05 ? cLoss : C_FLAT
            string tip = tipText(LT)
            tToday := table.new(cpos, 2, 7, bgcolor = K_BG, frame_color = hc, frame_width = 1, border_width = 0, force_overlay = true)
            table.cell(tToday, 0, 0, (showPrev ? "Last setup of " + fDate(TD.date) : "Last setup") + " · " + LET.get(LT.code) + " " + (s > 0 ? "LONG ▲" : "SHORT ▼") + " · " + SNAME.get(LT.code), text_color = inkOn(hc), bgcolor = hc, text_halign = text.align_left, text_size = size.small, text_formatting = text.format_bold, tooltip = tip)
            table.merge_cells(tToday, 0, 0, 1, 0)
            string resTx = ""
            color resC = hc
            if LT.skipped
                resTx := "not taken: " + LT.note
            else if LT.tin < 0
                resTx := LT.pending ? "limit order waiting until " + fHM(LT.ct + WAITM) : "limit order " + LT.note
            else if LT.isOpen
                float pnl = openPnl(LT, close)
                resTx := "open · " + fUsd(pnl) + " · " + fR(pnl / (PV * LT.m * LT.risk))
                resC := pnl >= 0 ? cWin : cLoss
            else
                resTx := (LT.r > 0.05 ? "won " : LT.r < -0.05 ? "lost " : "even ") + fUsd(LT.pnl) + " · " + fR(LT.r)
            boxRow(tToday, 1, "Result", resTx, resC, tip)
            boxRow(tToday, 2, "Entry", LT.tin >= 0 ? fHM(LT.tin) + " · " + fP(s * LT.entry) + " · " + str.tostring(LT.m) + " " + CNAME : (LT.code == 0 ? "limit " : "would be ") + fP(s * LT.entry), C_WHITE, tip)
            boxRow(tToday, 3, "Stop", fP(s * LT.stop) + " · " + fPts(LT.risk) + " pts" + (LT.isOpen and math.abs(LT.st - LT.stop) > 1e-9 ? " · now " + fP(s * LT.st) : ""), cLoss, tip)
            boxRow(tToday, 4, "Target", targetText(LT), cWin, tip)
            boxRow(tToday, 5, "Exit", fin ? fHM(LT.texit) + " · " + fP(LT.exitPx) + " · " + howText(LT.how) : LT.isOpen ? "open" : "—", fin ? hc : C_DIM, tip)
            boxRow(tToday, 6, "Why", whyText(LT), C_TXT, tip)
