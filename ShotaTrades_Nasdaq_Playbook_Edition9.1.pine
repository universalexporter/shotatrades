//@version=6
// ShotaTrades Nasdaq Playbook · Edition 9.1
// One price-action strategy with eight entry modules on the Nasdaq-100 futures (MNQ / NQ): A, B, C, E1, E2 and E3 in
// New York, L1 and L2 in London. Use it on the 5-minute chart with extended trading hours. All times are New York time.
// A signal is checked when its 5-minute candle closes. Every trade is then followed minute by minute with the 1-minute
// candles inside each 5-minute candle, with the course's entries, stops, exits and amounts. Every signal is taken: there is
// no daily trade or loss limit (the 15-minute pause after a loss and the two seats stay).
// Educational tool, not financial advice. Past results do not guarantee future results; your own results can be different.
// © 2026 ShotaTrades
// The trades, the zones, the hour gaps, the sessions, VWAP and the tables are drawn on the price chart; the volume has the
// indicator's own pane under it.
indicator("ShotaTrades Nasdaq Playbook", shorttitle = "ST Nasdaq", overlay = false, format = format.volume, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ============================================================================ inputs
// The course plan, exactly as taught: all eight setups, two seats, every signal taken. Only the money and the look are yours.
string CT0 = "MNQ · $2 a point"
string CT1 = "NQ · $20 a point"
string H0 = "Today only"
string H1 = "Last 2 days"
string H2 = "All loaded days"
string P0 = "Top right"
string P1 = "Bottom right"
string P2 = "Bottom left"
string Z0 = "S"
string Z1 = "M"
string Z2 = "L"
string GR = "Risk per trade (the course: $500 New York, $300 London; your first 20 trades at half)"
string GV = "On the chart"
string GP = "Panel"
string GC = "Colours"
string GA = "Alerts: create one alert with Any alert() function call, Once per bar close"

float rNY = input.float(500.0, "New York setups ($)", minval = 0, step = 25, display = display.none, group = GR, inline = "r1", tooltip = "A, B, C, E1, E2 and E3. The course trades $500; for your first 20 trades it advises half: $250.")
float rLD = input.float(300.0, "London setups ($)", minval = 0, step = 25, display = display.none, group = GR, inline = "r1", tooltip = "L1 and L2. The course trades $300; for your first 20 trades it advises half: $150.")
string ctIn = input.string(CT0, "Contract", options = [CT0, CT1], display = display.none, group = GR, tooltip = "Contracts = the setup's amount ÷ (stop in points × the point value), rounded down. A signal that gives less than one contract is skipped.")
int maxIn = input.int(50, "At most (MNQ)", minval = 1, maxval = 1000, display = display.none, group = GR, tooltip = "The account's maximum: 50 MNQ in a typical 50K account (5 NQ). With a very small stop the formula can ask for more; then the trade uses the maximum and risks less.")
float feeIn = input.float(1.0, "Commission a contract ($)", minval = 0, step = 0.25, display = display.none, group = GR, tooltip = "The course counts $1 a contract for MNQ, in every result.")
string histIn = input.string(H2, "Trades to show", options = [H0, H1, H2], display = display.none, group = GV, tooltip = "How many days of trades to draw. All loaded days goes back as far as your chart and your TradingView plan load 1-minute candles; the newest 90 trades stay drawn.")
bool showPast = input.bool(true, "Finished trades", display = display.none, group = GV, tooltip = "Glass zones from the entry to the exit: the target zone with its green line, the stop zone with its red line, the entry line, the entry tag (one colour for every setup, darker for the stronger one: A darkest) and the result at the exit, green when the trade won and red when it lost. Hover over the tag or the result for the whole trade. The open trade is purple, with its live result on the right.")
bool showLines = input.bool(true, "Day lines", display = display.none, group = GV, tooltip = "Today's zones with their name and price: the POC in yellow, the value area in amber, every other zone in blue. Hover over a tag to see what the zone is.")
bool showGaps = input.bool(true, "Hour gaps", display = display.none, group = GV, tooltip = "The 9 o'clock gap's rule, applied to every hour: on 15-minute candles, a gap of at least 1 point between the first candle's high and the third one's low in a rising hour (the mirror in a falling hour), not closed back through before the hour ends, and the hour closing beyond it. Information only: of these gaps, the plan trades the 9 o'clock gap (A).")
bool showSess = input.bool(true, "Sessions", display = display.none, group = GV, tooltip = "Asia 18:00 – 02:00, London 02:00 – 08:00 and New York 09:30 – 16:00, New York time: a thin band at the top, a faint line where each starts and ends, and its name. Hover over the name for its hours.")
bool showVwap = input.bool(true, "VWAP", display = display.none, group = GV, tooltip = "The course's VWAP, from 09:30, drawn in New York hours only (09:30 – 16:00).")
bool showVol = input.bool(true, "Volume (its own pane under the chart)", display = display.none, group = GV, tooltip = "In the candles' colours, with its measure: the line is the average volume of the 20 candles before; a dot over a bar marks 1.3 times that average or more, the volume check of B, C, E1, L1 and L2; the tag on the last candle gives its volume and how many times the average it is (also in the status line for any candle you point at).")
bool showInfo = input.bool(true, "Panel", display = display.none, group = GP, inline = "p1")
string infoPos = input.string(P0, "", options = [P0, P1, P2], display = display.none, group = GP, inline = "p1")
string infoSize = input.string(Z1, "text", options = [Z0, Z1, Z2], display = display.none, group = GP, inline = "p1", tooltip = "New York time, today's result, the trades and what can come next. Hover over a cell for more. Text size S, M or L, for this panel and the setups at the top left.")
bool showStats = input.bool(true, "The tested 12 months on top of the panel", display = display.none, group = GP, tooltip = "The plan's tested numbers at the course risk ($500 New York, $300 London): the last 12 months (Oct 2025 – Sep 2026) and, when you hover over them, the years before (Jan 2022 – Sep 2025). Your own results can be different.")
bool showKey = input.bool(true, "Setups and trend power, top left", display = display.none, group = GP, inline = "k1")
int keyGap = input.int(10, "down (%)", minval = 0, maxval = 40, display = display.none, group = GP, inline = "k1", tooltip = "The setups' colour (darker = stronger) and the power of longs and shorts from the plan's three trend checks. Move it down so it does not cover TradingView's legend.")
bool showToday = input.bool(false, "Last setup card", display = display.none, group = GP, tooltip = "A card with the last setup of the day: the result, the entry, the stop, the target, the exit and why.")
bool colBars = input.bool(true, "Colour the whole candle", display = display.none, group = GC, inline = "c1")
color cUp = input.color(#089981, "up", display = display.none, group = GC, inline = "c1")
color cDn = input.color(#F23645, "down", display = display.none, group = GC, inline = "c1", tooltip = "The body, the wick and the border of every candle, and the volume, take these colours: TradingView's own green and red by default.")
color cWin = input.color(#00E08A, "Results: won", display = display.none, group = GC, inline = "c2")
color cLoss = input.color(#FF4D6D, "lost", display = display.none, group = GC, inline = "c2")
color cLive = input.color(#9B5CF6, "live", display = display.none, group = GC, inline = "c2")
color cTagA = input.color(#173FB8, "Entry tags: A", display = display.none, group = GC, inline = "c3")
color cTagZ = input.color(#C3D8FF, "to L2", display = display.none, group = GC, inline = "c3", tooltip = "One colour for every entry tag, darker for the stronger setup: A darkest, then B, C, E1, E2, E3, L1 and L2 lightest.")
color cVwap = input.color(#22D3EE, "VWAP", display = display.none, group = GC, inline = "c4")
color cLvl = input.color(#4C8DFF, "Day lines", display = display.none, group = GC, inline = "c4")
color cPoc = input.color(#F5C518, "POC", display = display.none, group = GC, inline = "c4")
color cVa = input.color(#E0B341, "value area", display = display.none, group = GC, inline = "c4")
color cAsia = input.color(#2BB7A9, "Sessions: Asia", display = display.none, group = GC, inline = "c5")
color cLdn = input.color(#4C8DFF, "London", display = display.none, group = GC, inline = "c5")
color cNy = input.color(#F2C230, "New York", display = display.none, group = GC, inline = "c5")
bool liveIn = input.bool(false, "I trade it live: show what that needs", display = display.none, group = GA, tooltip = "Adds a checklist to the panel: real-time CME data, extended trading hours and the alert. With delayed data everything still shows, about 10 minutes late.")
bool alSig = input.bool(true, "New trade · A's limit order", display = display.none, group = GA)
bool alSkip = input.bool(true, "Signal not taken (a pause after a loss, no free seat)", display = display.none, group = GA)
bool alStep = input.bool(true, "First target · stop to the entry · trailing starts", display = display.none, group = GA)
bool alTrail = input.bool(false, "Every move of a trailing stop", display = display.none, group = GA)
bool alClose = input.bool(true, "Trade closed", display = display.none, group = GA)
bool alTest = input.bool(false, "Send a test alert", display = display.none, group = GA, tooltip = "Turn it on, then create the alert: at the first 5-minute close after the alert starts it sends one TEST alert, so you hear how the plan's alerts come (sound, phone, popup).")

// ============================================================================ the rules (Nasdaq points, New York time)
string TZ = "America/New_York"
float SLIP = 0.5
float THR = 0.25
float MERGE = 2.0
float TOUCH = 2.0
float QQ = 0.25
float VRMIN = 1.3
int FLAT = 955
int LONEND = 480
int HOLDM = 240
int WAITM = 30
// two seats in one direction and a 15-minute pause after a loss; every signal is taken (no daily trade or loss limit)
int SEATS = 2
int pauseMin = 15
// the newest trades kept on the chart (TradingView draws at most 500 labels, 500 lines and 500 boxes)
int MAXDRAWN = 90

color C_FLAT = #787B86
color C_TXT = #D1D4DC
color C_DIM = #8A93A6
color C_INK = #0B0E14
color C_WHITE = #FFFFFF
color C_NONE = color.new(#000000, 100)
// the panels: dark glass
color K_BG = #0D1017
color K_HEAD = #0A0D13
// the panels' text: bright, for the values; a softer one for the notes
color K_TXT = #ECEEF2
color K_SUB = #C3CAD6
color K_TIME = #2A2E39
color K_WARN = #5C4A12
// the chart's theme: the glass, the entry line and the hour gaps are light on a dark chart and dark on a light one
float BGL = (0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)) / 255
bool DARK = BGL < 0.5
color C_GLASS = DARK ? #FFFFFF : #2A2E39
color C_ENTRYL = DARK ? #FFFFFF : #131722
color C_GAPT = DARK ? #E6E9F0 : #2A2E39
// the result tags: white on a dark chart, light grey on a light one
color C_BADGE = DARK ? color.new(#F6F8FC, 2) : #E6EAF1

// a colour between two colours (k = 0: the first, k = 1: the second)
mixC(color a, color b, float k) =>
    color.rgb(color.r(a) + (color.r(b) - color.r(a)) * k, color.g(a) + (color.g(b) - color.g(a)) * k, color.b(a) + (color.b(b) - color.b(a)) * k)

// the entry tags: one colour for every setup, A darkest, L2 lightest
shadeOf(int code) =>
    mixC(cTagA, cTagZ, code / 7.0)

// dark text on a light colour, white text on a dark one
inkOn(color c) =>
    (0.299 * color.r(c) + 0.587 * color.g(c) + 0.114 * color.b(c)) / 255 > 0.63 ? #0B1A33 : #FFFFFF

color C_WIN_D = mixC(cWin, #000000, 0.25)
color C_LOSS_D = mixC(cLoss, #000000, 0.12)

var array<string> LET = array.from("A", "B", "C", "E1", "E2", "E3", "L1", "L2")
var array<string> SNAME = array.from("Nine O'Clock Turn", "Break & Hold", "Gap Breakout", "Level Bounce", "VWAP Snap-back", "False Break", "London Breakout", "London Bounce")
var array<bool> LDN = array.from(false, false, false, false, false, false, true, true)
// zones in the course's order: PDH PDL ONH ONL LNH LNL ASH ASL ORH ORL PDC POC VAH VAL
var array<string> ZN = array.from("PDH", "PDL", "ONH", "ONL", "LNH", "LNL", "ASH", "ASL", "ORH", "ORL", "PDC", "POC", "VAH", "VAL")
var array<int> ZMIR = array.from(1, 0, 3, 2, 5, 4, 7, 6, 9, 8, 10, 11, 13, 12)
var array<int> ZKNOWN = array.from(-9999, -9999, 570, 570, 480, 480, 120, 120, 585, 585, -9999, -9999, -9999, -9999)
// the zones of L2 (London): yesterday's high, low and close, the POC and value area, Asia's high and low
var array<bool> ZLON = array.from(true, true, false, false, false, false, true, true, false, false, true, true, true, true)
var array<string> ZSHORT = array.from("yesterday's high", "yesterday's low", "night high", "night low", "London high", "London low", "Asia high", "Asia low", "opening range high", "opening range low", "yesterday's close", "yesterday's POC", "value area high", "value area low")
var array<string> ZTIP = array.from("yesterday's high", "yesterday's low", "the night's high (18:00 – 09:30)", "the night's low (18:00 – 09:30)", "London's high (02:00 – 08:00)", "London's low (02:00 – 08:00)", "Asia's high (18:00 – 02:00)", "Asia's low (18:00 – 02:00)", "the opening range high (09:30 – 09:45)", "the opening range low (09:30 – 09:45)", "yesterday's close", "yesterday's point of control: the price with the most volume", "yesterday's value area high", "yesterday's value area low")
// sessions: Asia 18:00-02:00, London 02:00-08:00, the night 18:00-09:30, the opening range 09:30-09:45
var array<int> SS_A = array.from(-360, 120, -360, 570)
var array<int> SS_B = array.from(120, 480, 570, 585)
var array<int> SS_N = array.from(20, 20, 40, 3)
var array<int> SS_H = array.from(6, 4, 2, 8)
var array<int> SS_L = array.from(7, 5, 3, 9)
var array<string> MON = array.from("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
// market holidays and shortened sessions: no trades, and not used as the previous day
var array<int> HOL = array.from(20211224, 20220117, 20220221, 20220415, 20220530, 20220620, 20220704, 20220905, 20221124, 20221125, 20221226, 20230102, 20230116, 20230220, 20230407, 20230529, 20230619, 20230703, 20230704, 20230904, 20231123, 20231124, 20231225, 20240101, 20240115, 20240219, 20240329, 20240527, 20240619, 20240703, 20240704, 20240902, 20241128, 20241129, 20241224, 20241225, 20250101, 20250109, 20250120, 20250217, 20250418, 20250526, 20250619, 20250703, 20250704, 20250901, 20251127, 20251128, 20251224, 20251225, 20260101, 20260119, 20260216, 20260403, 20260525, 20260619, 20260703, 20260907, 20261126, 20261127, 20261224, 20261225, 20270101, 20270118, 20270215, 20270326, 20270531, 20270618, 20270705, 20270906, 20271125, 20271126, 20271224, 20280117, 20280221, 20280414, 20280529, 20280619, 20280703, 20280704, 20280904, 20281123, 20281124, 20281225)

// the course plan: all eight setups (A, B, C, E1, E2, E3, L1, L2)
float PV = ctIn == CT1 ? 20.0 : 2.0
string CNAME = ctIn == CT1 ? "NQ" : "MNQ"
int MAXM = ctIn == CT1 ? math.max(1, math.floor(maxIn / 10)) : maxIn
float FEE = feeIn
var array<bool> USE = array.new<bool>(8, true)

